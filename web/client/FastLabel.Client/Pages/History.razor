@page "/history"
@layout MainLayout
@attribute [Authorize]
@inherits TranslatableComponent

<CrudTablePage @ref="_crudTable"
               TItem="PrintHistoryDto" 
               TKey="int"
               ApiEndpoint="api/jobs"
               IdSelector="h => h.Id"
               CreateNewItem="@(() => new PrintHistoryDto { Quantity = 1 })"
               Title="@Translation.GetString("history.title")"
               Description="@Translation.GetString("history.description")"
               EmptyMessage="@Translation.GetString("history.no_history")"
               AddModalTitle="@Translation.GetString("history.add_title")"
               EditModalTitle="@Translation.GetString("history.edit_title")">

    <TableHeader>
        <th>@Translation.GetString("history.printer")</th>
        <th>@Translation.GetString("history.template")</th>
        <th>@Translation.GetString("history.quantity")</th>
        <th>@Translation.GetString("history.status")</th>
        <th>@Translation.GetString("history.date")</th>
    </TableHeader>

    <RowTemplate Context="item">
        <td>@item.PrinterName</td>
        <td>@item.TemplateName</td>
        <td>@item.Quantity</td>
        <td>
            <span class="badge bg-@(string.IsNullOrEmpty(item.ResponseMessage) ? "success" : "warning")">
                @(string.IsNullOrEmpty(item.ResponseMessage) ? Translation.GetString("history.status.success") : Translation.GetString("history.status.error"))
            </span>
        </td>
        <td>@(item.ProcessedAt?.ToLocalTime().ToString("g") ?? item.CreatedAt.ToLocalTime().ToString("g"))</td>
    </RowTemplate>

    <FormFields Context="item">
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("history.printer")</label>
            <InputText class="form-control" @bind-Value="item.PrinterName" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("history.template")</label>
            <InputText class="form-control" @bind-Value="item.TemplateName" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("history.quantity")</label>
            <InputNumber class="form-control" @bind-Value="item.Quantity" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("history.response_message")</label>
            <InputText class="form-control" @bind-Value="item.ResponseMessage" />
        </div>
    </FormFields>

</CrudTablePage>

@code {
    private CrudTablePage<PrintHistoryDto, int>? _crudTable;

    protected override async Task OnLanguageChangedAsync()
    {
        StateHasChanged();
        if (_crudTable != null)
        {
            await _crudTable.LoadDataAsync();
        }
    }
}