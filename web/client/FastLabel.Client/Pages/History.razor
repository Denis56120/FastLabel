@page "/history"
@attribute [Authorize]
@inherits TranslatableComponent
@inject IHttpClientFactory ClientFactory

<div class="container-fluid">
    <h3 class="mb-3">@Translation.GetString("history.title")</h3>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Translation.GetString("common.loading")</span>
            </div>
        </div>
    }
    else if (_historyItems == null || !_historyItems.Any())
    {
        <p class="text-muted">@Translation.GetString("history.description")</p>
    
        <div class="alert alert-secondary" role="alert">
            @Translation.GetString("history.no_history")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>@Translation.GetString("history.printer")</th>
                        <th>@Translation.GetString("history.template")</th>
                        <th>@Translation.GetString("history.quantity")</th>
                        <th>@Translation.GetString("history.status")</th>
                        <th>@Translation.GetString("history.date")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _historyItems)
                    {
                        <tr>
                            <td>@item.PrinterName</td>
                            <td>@item.TemplateName</td>
                            <td>@item.Quantity</td>
                            <td>
                                <span class="badge bg-@(string.IsNullOrEmpty(item.ResponseMessage) ? "success" : "warning")">
                                    @(string.IsNullOrEmpty(item.ResponseMessage) ? "Success" : "Error")
                                </span>
                            </td>
                            <td>@(item.ProcessedAt?.ToLocalTime().ToString("g") ?? item.CreatedAt.ToLocalTime().ToString("g"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<PrintHistoryDto> _historyItems = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        isLoading = true;
        try
        {
            var client = ClientFactory.CreateClient("AuthClient");
            _historyItems = await client.GetFromJsonAsync<List<PrintHistoryDto>>("api/print-history") ?? new();
        }
        catch (Exception)
        {
            _historyItems = new();
        }
        finally
        {
            isLoading = false;
        }
    }
}