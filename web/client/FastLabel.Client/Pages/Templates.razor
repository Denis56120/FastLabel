@page "/templates"
@layout MainLayout
@attribute [Authorize]
@inject TranslationService Translation
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<CrudTablePage @ref="_crudTable"
               TItem="TemplateDto" 
               TKey="int"
               ApiEndpoint="api/templates"
               IdSelector="t => t.Id"
               CreateNewItem="@(() => new TemplateDto())"
               Title="@Translation.GetString("templates.title")"
               Description="@Translation.GetString("templates.description")"
               EmptyMessage="@Translation.GetString("templates.no_templates")"
               AddModalTitle="@Translation.GetString("templates.add_title")"
               EditModalTitle="@Translation.GetString("templates.edit_title")">

    <CustomToolbarActions Context="template">
        <button class="btn btn-outline-primary" @onclick="() => EditRenderer(template.Id)">
            <i class="bi bi-palette"></i> @Translation.GetString("templates.edit_renderer")
        </button>
    </CustomToolbarActions>

    <TableHeader>
        @if (_isAdmin)
        {
            <th>@Translation.GetString("templates.user")</th>
        }
        <th>@Translation.GetString("templates.name")</th>
        <th>@Translation.GetString("templates.status")</th>
        <th>@Translation.GetString("templates.created_at")</th>
        <th>@Translation.GetString("templates.updated_at")</th>
    </TableHeader>

    <RowTemplate Context="template">
        @if (_isAdmin)
        {
            <td>@template.UserName</td>
        }
        <td>@template.Name</td>
        <td>@template.BasicStatusName</td>
        <td>@template.CreatedAt.ToLocalTime().ToString("g")</td>
        <td>@template.UpdatedAt.ToLocalTime().ToString("g")</td>
    </RowTemplate>

    <FormFields Context="template">
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("templates.name")</label>
            <InputText class="form-control" @bind-Value="template.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("templates.json_data")</label>
            <InputTextArea class="form-control font-monospace" rows="5" @bind-Value="template.JsonData" />
        </div>
    </FormFields>

</CrudTablePage>

@code {
    private CrudTablePage<TemplateDto, int>? _crudTable;
    private bool _isAdmin;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var authState = await AuthStateTask;
        var user = authState.User;
        _isAdmin = user.IsInRole("Admin");
    }

    private void EditRenderer(int id)
    {
        Navigation.NavigateTo($"/templates/render/{id}");
    }
}