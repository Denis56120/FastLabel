@page "/templates"
@layout MainLayout
@attribute [Authorize]
@inject TranslationService Translation
@inject NavigationManager Navigation

<CrudTablePage @ref="_crudTable"
               TItem="TemplateDto" 
               TKey="int"
               ApiEndpoint="api/templates"
               IdSelector="t => t.Id"
               CreateNewItem="@(() => new TemplateDto { JsonData = "{}" })"
               Title="@Translation.GetString("templates.title")"
               Description="@Translation.GetString("templates.description")"
               EmptyMessage="@Translation.GetString("templates.no_templates")"
               AddModalTitle="@Translation.GetString("templates.add_title")"
               EditModalTitle="@Translation.GetString("templates.edit_title")">

    <TableHeader>
        @if (_isAdmin)
        {
            <th role="button" @onclick='() => SortAsync("UserName")'>
                @Translation.GetString("templates.user") <i class="bi bi-arrow-down-up small text-muted"></i>
            </th>
        }
        <th role="button" @onclick='() => SortAsync("Name")'>
            @Translation.GetString("templates.name") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("BasicStatusName")'>
            @Translation.GetString("templates.status") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("CreatedAt")'>
            @Translation.GetString("templates.created_at") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("UpdatedAt")'>
            @Translation.GetString("templates.updated_at") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th class="text-end">Actions</th>
    </TableHeader>

    <TableFilters>
        @if (_isAdmin)
        {
            <th>
                <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                       @oninput='e => FilterAsync("filterByUser", e.Value?.ToString())' />
            </th>
        }
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                   @oninput='e => FilterAsync("filterByName", e.Value?.ToString())' />
        </th>
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                   @oninput='e => FilterAsync("filterByStatus", e.Value?.ToString())' />
        </th>
        <th></th>
        <th></th>
        <th></th>
    </TableFilters>

    <RowTemplate Context="template">
        @if (_isAdmin)
        {
            <td>@template.UserName</td>
        }
        <td>@template.Name</td>
        <td>@template.BasicStatusName</td>
        <td>@template.CreatedAt.ToLocalTime().ToString("g")</td>
        <td>@template.UpdatedAt.ToLocalTime().ToString("g")</td>
        <td class="text-end">
            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditRenderer(template.Id)" title="@Translation.GetString("templates.edit_renderer")">
                <i class="bi bi-palette"></i>
            </button>
        </td>
    </RowTemplate>

    <FormFields Context="template">
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("templates.name")</label>
            <InputText class="form-control" @bind-Value="template.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("templates.json_data")</label>
            <InputTextArea class="form-control font-monospace" rows="5" @bind-Value="template.JsonData" />
        </div>
    </FormFields>

</CrudTablePage>

@code {
    private CrudTablePage<TemplateDto, int>? _crudTable;
    private bool _isAdmin;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var authState = await AuthStateTask;
        var user = authState.User;
        _isAdmin = user.IsInRole("Admin");
    }

    private void EditRenderer(int id)
    {
        Navigation.NavigateTo($"/templates/render/{id}");
    }

    private async Task SortAsync(string columnName)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplySortAsync(columnName);
        }
    }

    private async Task FilterAsync(string columnName, string? value)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplyFilterAsync(columnName, value ?? string.Empty);
        }
    }
}