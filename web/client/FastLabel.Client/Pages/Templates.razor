@page "/templates"
@layout MainLayout
@attribute [Authorize]
@inherits TranslatableComponent

<CrudTablePage @ref="_crudTable"
               TItem="TemplateDto" 
               TKey="int"
               ApiEndpoint="api/templates"
               IdSelector="t => t.Id"
               CreateNewItem="@(() => new TemplateDto())"
               Title="@Translation.GetString("templates.title")"
               Description="@Translation.GetString("templates.description")"
               EmptyMessage="@Translation.GetString("templates.no_templates")"
               AddModalTitle="@Translation.GetString("templates.add_title")"
               EditModalTitle="@Translation.GetString("templates.edit_title")">

    <TableHeader>
        <th>@Translation.GetString("templates.name")</th>
        <th>@Translation.GetString("templates.status")</th>
        <th>@Translation.GetString("templates.updated_at")</th>
    </TableHeader>

    <RowTemplate Context="template">
        <td>@template.Name</td>
        <td>@template.BasicStatusName</td>
        <td>@template.UpdatedAt.ToLocalTime().ToString("g")</td>
    </RowTemplate>

    <FormFields Context="template">
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("templates.name")</label>
            <InputText class="form-control" @bind-Value="template.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("templates.status")</label>
            <InputText class="form-control" @bind-Value="template.BasicStatusName" />
        </div>
    </FormFields>

</CrudTablePage>

@code {
    private CrudTablePage<TemplateDto, int>? _crudTable;

    protected override async Task OnLanguageChangedAsync()
    {
        StateHasChanged();
        if (_crudTable != null)
        {
            await _crudTable.LoadDataAsync();
        }
    }
}