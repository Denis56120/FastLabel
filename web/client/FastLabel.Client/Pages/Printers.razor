@page "/printers"
@layout MainLayout
@attribute [Authorize]
@inject TranslationService Translation
@inject ApiClient ApiClient

<CrudTablePage @ref="_crudTable"
               TItem="PrinterDto" 
               TKey="int"
               ApiEndpoint="api/printers"
               IdSelector="p => p.Id"
               CreateNewItem="@(() => new PrinterDto { Port = 9100 })"
               Title="@Translation.GetString("printers.title")"
               Description="@Translation.GetString("printers.description")"
               EmptyMessage="@Translation.GetString("printers.no_printers")"
               AddModalTitle="@Translation.GetString("printers.add_title")"
               EditModalTitle="@Translation.GetString("printers.edit_title")">

    <TableHeader>
        @if (_isAdmin)
        {
            <th role="button" @onclick='() => SortAsync("UserName")'>
                @Translation.GetString("printers.user") <i class="bi bi-arrow-down-up small text-muted"></i>
            </th>
        }
        <th role="button" @onclick='() => SortAsync("Name")'>
            @Translation.GetString("printers.name") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("Location")'>
            @Translation.GetString("printers.location") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th>@Translation.GetString("printers.ip_port")</th>
        <th role="button" @onclick='() => SortAsync("ProtocolName")'>
            @Translation.GetString("printers.protocol") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("ResolutionDpiValue")'>
            @Translation.GetString("printers.resolution") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("StatusName")'>
            @Translation.GetString("printers.status") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("CreatedAt")'>
            @Translation.GetString("printers.created_at") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
    </TableHeader>

    <TableFilters>
        @if (_isAdmin)
        {
            <th>
                <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                       @oninput='e => FilterAsync("filterByUser", e.Value?.ToString())' />
            </th>
        }
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                   @oninput='e => FilterAsync("filterByName", e.Value?.ToString())' />
        </th>
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                   @oninput='e => FilterAsync("filterByLocation", e.Value?.ToString())' />
        </th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
    </TableFilters>

    <RowTemplate Context="printer">
        @if (_isAdmin)
        {
            <td>@printer.UserName</td>
        }
        <td>@printer.Name</td>
        <td>@printer.Location</td>
        <td>@printer.IP:@printer.Port</td>
        <td>@printer.ProtocolName</td>
        <td>@printer.ResolutionDpiName</td>
        <td>@printer.StatusName</td>
        <td>@printer.CreatedAt.ToLocalTime().ToString("g")</td>
    </RowTemplate>

    <FormFields Context="printer">
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("printers.name")</label>
            <InputText class="form-control" @bind-Value="printer.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("printers.location")</label>
            <InputText class="form-control" @bind-Value="printer.Location" />
        </div>
        <div class="row">
            <div class="col-md-8 mb-3">
                <label class="form-label">@Translation.GetString("printers.ip")</label>
                <InputText class="form-control" @bind-Value="printer.IP" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">@Translation.GetString("printers.port")</label>
                <InputNumber class="form-control" @bind-Value="printer.Port" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">@Translation.GetString("printers.protocol")</label>
                <InputSelect class="form-select" @bind-Value="printer.ProtocolId">
                    <option value="">@Translation.GetString("printers.select_protocol")</option>
                    @if (_protocols != null)
                    {
                        @foreach (var proto in _protocols)
                        {
                            <option value="@proto.Id">@proto.Name</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">@Translation.GetString("printers.resolution")</label>
                <InputSelect class="form-select" @bind-Value="printer.ResolutionDpiId">
                    <option value="">@Translation.GetString("printers.select_resolution")</option>
                    @if (_resolutions != null)
                    {
                        @foreach (var res in _resolutions)
                        {
                            <option value="@res.Id">@res.Value DPI</option>
                        }
                    }
                </InputSelect>
            </div>
        </div>
    </FormFields>

</CrudTablePage>

@code {
    private CrudTablePage<PrinterDto, int>? _crudTable;
    private List<ProtocolDto> _protocols = new();
    private List<ResolutionDpiDto> _resolutions = new();
    private bool _isAdmin;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var authState = await AuthStateTask;
        var user = authState.User;
        _isAdmin = user.IsInRole("Admin");

        await LoadDropdownDataAsync();
    }

    private async Task LoadDropdownDataAsync()
    {
        try
        {
            _protocols = await ApiClient.GetFromJsonAsync<List<ProtocolDto>>("api/protocols") ?? new();
            _resolutions = await ApiClient.GetFromJsonAsync<List<ResolutionDpiDto>>("api/resolutions") ?? new();
        }
        catch (Exception)
        {
        }
    }

    private async Task SortAsync(string columnName)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplySortAsync(columnName);
        }
    }

    private async Task FilterAsync(string columnName, string? value)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplyFilterAsync(columnName, value ?? string.Empty);
        }
    }
}