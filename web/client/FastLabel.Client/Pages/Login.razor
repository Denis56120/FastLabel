@page "/"
@layout PublicLayout
@inherits TranslatableComponent
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject CookieService CookieService
@inject ToastService ToastService

<div class="d-flex justify-content-center align-items-center w-100">
    <div style="width: 100%; max-width: 420px;">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">@Translation.GetString("auth.login_title")</h3>

                <EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">@Translation.GetString("auth.email")</label>
                        <InputText @bind-Value="_loginModel.Email" class="form-control"
                                   placeholder="@Translation.GetString("auth.email_placeholder")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Translation.GetString("auth.password")</label>
                        <div class="input-group">
                            <input type="@PasswordInputType" @bind="_loginModel.Password" @bind:event="oninput"
                                   class="form-control" placeholder="••••••••" />
                            <button type="button" class="btn btn-outline-secondary" style="border-color: #ced4da;"
                                    @onclick="TogglePasswordVisibility">
                                <i class="bi @PasswordIconClass" style="pointer-events: none;"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>@Translation.GetString("auth.submitting")</span>
                            }
                            else
                            {
                                <span>@Translation.GetString("auth.submit")</span>
                            }
                        </button>
                    </div>

                    <div class="d-flex justify-content-between text-center">
                        <a href="/register">@Translation.GetString("auth.create_account")</a>
                        <a href="/forgot-password" class="text-muted">@Translation.GetString("auth.forgot_password")</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginDto _loginModel = new();
    private bool _isLoading = false;
    private bool _showPassword = false;

    [SupplyParameterFromQuery(Name = "activated")]
    public bool? ActivatedParam { get; set; }

    [SupplyParameterFromQuery(Name = "pwreset")]
    public bool? PwResetParam { get; set; }

    [SupplyParameterFromQuery(Name = "pwupdated")]
    public bool? PwUpdatedParam { get; set; }

    private string PasswordInputType => _showPassword ? "text" : "password";
    private string PasswordIconClass => _showPassword ? "bi-eye-slash" : "bi-eye";

    protected override void OnParametersSet()
    {
        if (ActivatedParam == true)
        {
            ToastService.ShowSuccess(Translation.GetString("auth.success.account_activated"));
        }
        if (PwResetParam == true)
        {
            ToastService.ShowSuccess(Translation.GetString("auth.forgot_success_message"));
        }
        if (PwUpdatedParam == true)
        {
            ToastService.ShowSuccess(Translation.GetString("auth.success.password_reset"));
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleLogin()
    {
        _isLoading = true;

        try
        {
            var success = await AuthService.LoginAsync(_loginModel);

            if (success)
            {
                try
                {
                    await CookieService.SetCookieAsync("language", Translation.CurrentLanguage, days: 365);
                }
                catch
                {
                    // Ignorer les erreurs non bloquantes de cookie de langue
                }

                ToastService.ShowSuccess(Translation.GetString("auth.success.login"));
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                ToastService.ShowError(Translation.GetString("auth.error.invalid_credentials"));
            }
        }
        catch (Exception)
        {
            ToastService.ShowError(Translation.GetString("auth.error.server_unreachable"));
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}