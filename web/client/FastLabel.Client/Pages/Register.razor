@page "/register"
@inherits TranslatableComponent
@layout PublicLayout
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject CookieService CookieService
@using FastLabel.Client.Components
@using FastLabel.Client.Components.Layout
@using FastLabel.Client.Services
@using FastLabel.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<div class="d-flex justify-content-center align-items-center w-100">
    <div style="width: 100%; max-width: 420px;">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">@Translation.GetString("auth.register_title")</h3>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @_errorMessage
                    </div>
                }

                <EditForm Model="_registerModel" OnValidSubmit="HandleRegister">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">@Translation.GetString("auth.name")</label>
                        <InputText @bind-Value="_registerModel.Name" class="form-control" placeholder="@Translation.GetString("auth.name_placeholder")" />
                        <ValidationMessage For="@(() => _registerModel.Name)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Translation.GetString("auth.email")</label>
                        <InputText @bind-Value="_registerModel.Email" class="form-control" placeholder="@Translation.GetString("auth.email_placeholder")" />
                        <ValidationMessage For="@(() => _registerModel.Email)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Translation.GetString("auth.password")</label>
                        <div class="input-group">
                            <input type="@PasswordInputType" 
                                   @bind="_registerModel.Password" 
                                   @bind:event="oninput"
                                   class="form-control"
                                   placeholder="••••••••" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordVisibility">
                                <i class="bi @PasswordIconClass" style="pointer-events: none;"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _registerModel.Password)" />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success">@Translation.GetString("auth.register_button")</button>
                    </div>

                    <div class="text-center">
                        <a href="/">@Translation.GetString("auth.already_have_account")</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterDto _registerModel = new();
    private string? _errorMessage;
    private bool _showPassword = false;

    private string PasswordInputType => _showPassword ? "text" : "password";
    private string PasswordIconClass => _showPassword ? "bi-eye-slash" : "bi-eye";

     private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleRegister()
    {
        _errorMessage = null;

        _registerModel.Language = !string.IsNullOrEmpty(Translation.CurrentLanguage) 
            ? Translation.CurrentLanguage 
            : "en";

        try
        {
            var client = ClientFactory.CreateClient("PublicClient");
            var response = await client.PostAsJsonAsync("api/auth/register", _registerModel);

            if (response.IsSuccessStatusCode)
            {
                try
                {
                    await CookieService.SetCookieAsync("language", Translation.CurrentLanguage, days: 365);
                }
                catch
                {
                }

                Navigation.NavigateTo("/");
            }
            else
            {
                var errorContent = await response.Content.ReadFromJsonAsync<ErrorResponseDto>();
                string errorKey = !string.IsNullOrEmpty(errorContent?.Message) ? errorContent.Message : "auth.error.registration_failed";
                _errorMessage = Translation.GetString(errorKey);
            }
        }
        catch (Exception)
        {
            _errorMessage = Translation.GetString("auth.error.server_unreachable");
        }

        StateHasChanged();
    }
}