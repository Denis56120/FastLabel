@page "/register"
@layout PublicLayout
@inherits TranslatableComponent
@inject IHttpClientFactory ClientFactory
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject CookieService CookieService

<div class="d-flex justify-content-center align-items-center w-100">
    <div style="width: 100%; max-width: 420px;">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">@Translation.GetString("auth.register_title")</h3>

                <EditForm Model="_registerModel" OnValidSubmit="HandleRegister">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">@Translation.GetString("auth.name")</label>
                        <InputText @bind-Value="_registerModel.Name" class="form-control"
                                   placeholder="@Translation.GetString("auth.name_placeholder")" />
                        <ValidationMessage For="@(() => _registerModel.Name)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Translation.GetString("auth.email")</label>
                        <InputText @bind-Value="_registerModel.Email" class="form-control"
                                   placeholder="@Translation.GetString("auth.email_placeholder")" />
                        <ValidationMessage For="@(() => _registerModel.Email)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Translation.GetString("auth.password")</label>
                        <div class="input-group">
                            <input type="@PasswordInputType" @bind="_registerModel.Password" @bind:event="oninput"
                                   class="form-control" placeholder="••••••••" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordVisibility">
                                <i class="bi @PasswordIconClass" style="pointer-events: none;"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _registerModel.Password)" />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>@Translation.GetString("auth.submitting")</span>
                            }
                            else
                            {
                                <span>@Translation.GetString("auth.register_button")</span>
                            }
                        </button>
                    </div>

                    <div class="text-center">
                        <a href="/">@Translation.GetString("auth.already_have_account")</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterDto _registerModel = new();
    private bool _isLoading = false;
    private bool _showPassword = false;

    private string PasswordInputType => _showPassword ? "text" : "password";
    private string PasswordIconClass => _showPassword ? "bi-eye-slash" : "bi-eye";

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleRegister()
    {
        _isLoading = true;

        try
        {
            var client = ClientFactory.CreateClient("PublicClient");
            var response = await client.PostAsJsonAsync("api/auth/register", _registerModel);

            if (response.IsSuccessStatusCode)
            {
                try
                {
                    await CookieService.SetCookieAsync("language", Translation.CurrentLanguage, days: 365);
                }
                catch
                {
                }

                ToastService.ShowSuccess("auth.success.registered");
                Navigation.NavigateTo("/");
            }
            else
            {
                var errorContent = await response.Content.ReadFromJsonAsync<ErrorResponseDto>();
                string errorKey = !string.IsNullOrEmpty(errorContent?.Message) ? errorContent.Message : "auth.error.registration_failed";
                ToastService.ShowError(errorKey);
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("auth.error.server_unreachable");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}