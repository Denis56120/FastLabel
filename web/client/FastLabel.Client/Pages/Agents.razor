@page "/agents"
@layout MainLayout
@attribute [Authorize]
@inject TranslationService Translation
@inject ToastService ToastService
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<CrudTablePage @ref="_crudTable"
               TItem="AgentDto" 
               TKey="int"
               ApiEndpoint="api/agents"
               IdSelector="a => a.Id"
               IsReadOnly="true"
               CreateNewItem="CreateNewAgent"
               Title="@Translation.GetString("agents.title")"
               Description="@Translation.GetString("agents.description")"
               EmptyMessage="@Translation.GetString("agents.no_agents")"
               AddModalTitle="@Translation.GetString("agents.add_title")"
               EditModalTitle="@Translation.GetString("agents.edit_title")">

    <TableHeader>
        @if (_isAdmin)
        {
            <th role="button" @onclick='() => SortAsync("UserName")'>
                @Translation.GetString("agents.user") <i class="bi bi-arrow-down-up small text-muted"></i>
            </th>
        }
        <th role="button" @onclick='() => SortAsync("AgentTypeName")'>
            @Translation.GetString("agents.type") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th>@Translation.GetString("agents.api_key")</th>
        <th role="button" @onclick='() => SortAsync("CreatedAt")'>
            @Translation.GetString("agents.created_at") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("LastSeenAt")'>
            @Translation.GetString("agents.last_seen") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
    </TableHeader>

    <TableFilters>
        @if (_isAdmin)
        {
            <th>
                <input type="text" class="form-control form-control-sm" placeholder="@Translation.GetString("common.filter_placeholder")" 
                       @oninput='e => FilterAsync("filterByUser", e.Value?.ToString())' />
            </th>
        }
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="@Translation.GetString("common.filter_placeholder")" 
                   @oninput='e => FilterAsync("filterByType", e.Value?.ToString())' />
        </th>
        <th></th>
        <th></th>
        <th></th>
    </TableFilters>

    <RowTemplate Context="agent">
        @if (_isAdmin)
        {
            <td>@agent.UserName</td>
        }
        <td>@agent.AgentTypeName</td>
        <td>
            <div class="d-flex align-items-center gap-2">
                <code>@agent.ApiKey</code>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        title="@Translation.GetString("agents.copy_api_key")"
                        @onclick="() => CopyApiKeyAsync(agent.ApiKey)">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
        </td>
        <td>@agent.CreatedAt.ToLocalTime().ToString("d")</td>
        <td>@(agent.LastSeenAt?.ToLocalTime().ToString("d") ?? "-")</td>
    </RowTemplate>

    <FormFields Context="agent">
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("agents.type")</label>
            <InputSelect class="form-select" @bind-Value="agent.AgentTypeId">
                <option value="">@Translation.GetString("agents.select_type")</option>
                @if (_agentTypes != null)
                {
                    @foreach (var type in _agentTypes)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                }
            </InputSelect>
        </div>
    </FormFields>

</CrudTablePage>

@code {
    private CrudTablePage<AgentDto, int>? _crudTable;
    private List<AgentTypeDto> _agentTypes = new();
    private bool _isAdmin;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    private AgentDto CreateNewAgent()
    {
        return new AgentDto();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var authState = await AuthStateTask;
        var user = authState.User;
        _isAdmin = user.IsInRole("Admin");

        await LoadAgentTypesAsync();
    }

    private async Task LoadAgentTypesAsync()
    {
        try
        {
            _agentTypes = await ApiClient.GetFromJsonAsync<List<AgentTypeDto>>("api/agenttypes") ?? new();
        }
        catch (Exception ex)
        {
            AppLog.Error(ex);
            ToastService.ShowError(Translation.GetString("app.error.unknown"));
        }
    }

    private async Task CopyApiKeyAsync(string? apiKey)
    {
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            ToastService.ShowError(Translation.GetString("agents.error.copy_api_key_failed"));
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", apiKey);
            ToastService.ShowSuccess(Translation.GetString("agents.success.api_key_copied"));
        }
        catch (Exception ex)
        {
            AppLog.Error(ex);
            ToastService.ShowError(Translation.GetString("agents.error.copy_api_key_failed"));
        }
    }

    private async Task SortAsync(string columnName)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplySortAsync(columnName);
        }
    }

    private async Task FilterAsync(string columnName, string? value)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplyFilterAsync(columnName, value ?? string.Empty);
        }
    }
}