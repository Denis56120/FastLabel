@page "/clients"
@layout MainLayout
@attribute [Authorize(Roles = "Reseller")]
@inject TranslationService Translation

<CrudTablePage @ref="_crudTable"
               TItem="UserDto" 
               TKey="int"
               ApiEndpoint="api/clients"
               DisableEdit="true"
               IdSelector="u => u.Id"
               CreateNewItem="@(() => new UserDto())"
               Title="@Translation.GetString("clients.title")"
               Description="@Translation.GetString("clients.description")"
               EmptyMessage="@Translation.GetString("clients.no_clients")"
               AddModalTitle="@Translation.GetString("clients.add_title")"
               EditModalTitle="@Translation.GetString("clients.edit_title")">

    <TableHeader>
        <th role="button" @onclick='() => SortAsync("Name")'>
            @Translation.GetString("users.name") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("Email")'>
            @Translation.GetString("users.email") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("CreatedAt")'>
            @Translation.GetString("users.created_at") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
    </TableHeader>

    <TableFilters>
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="@Translation.GetString("common.filter_placeholder")" 
                   @oninput='e => FilterAsync("filterByName", e.Value?.ToString())' />
        </th>
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="@Translation.GetString("common.filter_placeholder")" 
                   @oninput='e => FilterAsync("filterByEmail", e.Value?.ToString())' />
        </th>
        <th></th>
    </TableFilters>

    <RowTemplate Context="client">
        <td>@client.Name</td>
        <td>@client.Email</td>
        <td>@client.CreatedAt.ToLocalTime().ToString("d")</td>
    </RowTemplate>

    <FormFields Context="client">
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("users.name")</label>
            <InputText class="form-control" @bind-Value="client.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("users.email")</label>
            <InputText class="form-control" @bind-Value="client.Email" />
        </div>
    </FormFields>

</CrudTablePage>

@code {
    private CrudTablePage<UserDto, int>? _crudTable;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    private async Task SortAsync(string columnName)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplySortAsync(columnName);
        }
    }

    private async Task FilterAsync(string columnName, string? value)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplyFilterAsync(columnName, value ?? string.Empty);
        }
    }
}