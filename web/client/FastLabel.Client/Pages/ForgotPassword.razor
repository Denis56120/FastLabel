@page "/forgot-password"
@layout PublicLayout
@using FastLabel.Client.Components.Layout

<div class="auth-container">
    <h2>Mot de passe oublié</h2>
    <p>Entre ton adresse email pour recevoir les instructions de réinitialisation.</p>
    
    <input type="email" placeholder="votre@email.com" class="form-control mb-3" />
    <button class="btn btn-primary">Envoyer le lien</button>
    
    <div class="mt-3">
        <a href="/login">Retour à la connexion</a>
    </div>
</div>