@page "/forgot-password"
@layout PublicLayout
@inject IHttpClientFactory ClientFactory
@inject TranslationService Translation
@using Microsoft.AspNetCore.Components.Forms
@using FastLabel.Client.Components.Layout
@using FastLabel.Shared.DTOs

<div style="width: 100%; max-width: 450px;">
    <div class="card shadow border-0">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-3">@Translation.GetString("auth.forgot_heading")</h3>
            <p class="text-muted text-center mb-4">@Translation.GetString("auth.forgot_instruction")</p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @_errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert alert-success" role="alert">
                    @_successMessage
                </div>
            }
            else
            {
                <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <InputText type="email" 
                                   @bind-Value="_model.Email" 
                                   placeholder="@Translation.GetString("auth.email_placeholder_alt")" 
                                   class="form-control" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>@Translation.GetString("auth.sending")</span>
                            }
                            else
                            {
                                <span>@Translation.GetString("auth.send_link_button")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }

            <div class="text-center mt-3">
                <a href="/login">@Translation.GetString("auth.back_to_login")</a>
            </div>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordDto _model = new();
    private bool _isLoading = false;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        _successMessage = null;
        _isLoading = true;

        try
        {
            var client = ClientFactory.CreateClient("PublicClient");
            var response = await client.PostAsJsonAsync("api/auth/forgot-password", _model);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = Translation.CurrentLanguage.StartsWith("fr") 
                    ? "Si un compte est associé à cet email, un lien de réinitialisation a été envoyé." 
                    : "If an account matches this email, a recovery link has been sent.";
            }
            else
            {
                _errorMessage = Translation.CurrentLanguage.StartsWith("fr") 
                    ? "Une erreur est survenue lors de la demande." 
                    : "An error occurred while processing your request.";
            }
        }
        catch (Exception)
        {
            _errorMessage = Translation.CurrentLanguage.StartsWith("fr") 
                ? "Impossible de joindre le serveur." 
                : "Unable to reach the server.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}