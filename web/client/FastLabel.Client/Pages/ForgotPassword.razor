@page "/forgot-password"
@layout PublicLayout
@implements IDisposable
@inject TranslationService Translation
@using FastLabel.Client.Components.Layout

@if (!_isReady)
{
    <div class="d-flex justify-content-center align-items-center w-100" style="min-height: 300px;">
        <!-- Garde anti-clignotement transparente -->
    </div>
}
else
{
    <div style="width: 100%; max-width: 450px;">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-3">@Translation.GetString("auth.forgot_heading")</h3>
                <p class="text-muted text-center mb-4">@Translation.GetString("auth.forgot_instruction")</p>
                
                <div class="mb-3">
                    <input type="email" placeholder="@Translation.GetString("auth.email_placeholder_alt")" class="form-control" />
                </div>
                
                <div class="d-grid mb-3">
                    <button class="btn btn-primary">@Translation.GetString("auth.send_link_button")</button>
                </div>
                
                <div class="text-center">
                    <a href="/login">@Translation.GetString("auth.back_to_login")</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isReady = false;

    protected override void OnInitialized()
    {
        Translation.OnChange += OnTranslationChanged;
        
        // Si le layout a déjà chargé le dictionnaire au démarrage, on s'affiche instantanément
        _isReady = !string.IsNullOrEmpty(Translation.GetString("auth.forgot_heading"));
    }

    private void OnTranslationChanged()
    {
        _isReady = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Translation.OnChange -= OnTranslationChanged;
    }
}