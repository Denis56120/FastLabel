@page "/dashboard"
@attribute [Authorize]
@inherits TranslatableComponent
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

@using FastLabel.Client.Components
@using Microsoft.AspNetCore.Authorization

<div class="container-fluid">
    <h3 class="mb-3">@Translation.GetString("dashboard.title")</h3>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Translation.GetString("common.loading")</span>
            </div>
        </div>
    }
    else
    {
        <h5 class="text-muted mb-4">@Translation.GetString("dashboard.agents_header")</h5>

        <p class="text-secondary">@Translation.GetString("dashboard.agents_description")</p>
        
        <div class="alert alert-info" role="alert">
            @Translation.GetString("dashboard.no_active_agents")
        </div>
    }
</div>

@code {
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
        }
        catch(Exception)
        {
        }
        finally
        {
            isLoading = false;
        }
    }
}