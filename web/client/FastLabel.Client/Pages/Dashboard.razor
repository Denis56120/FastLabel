@page "/dashboard"
@page "/dashboard/subscription/success"
@page "/dashboard/subscription/cancel"
@layout MainLayout
@attribute [Authorize]
@inject ApiClient ApiClient
@inject TranslationService Translation
@inject ToastService ToastService
@inject ILogger Logger
@inject NavigationManager Navigation

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">@Translation.GetString("dashboard.title")</h2>
            <p class="text-muted">@Translation.GetString("dashboard.welcome_subtitle")</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Translation.GetString("common.loading")</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0 bg-primary bg-opacity-10 p-3 rounded text-primary">
                                <i class="bi bi-person-badge fs-4"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="text-muted mb-1">@Translation.GetString("dashboard.profile_status")</h6>
                                <h5 class="mb-0 fw-semibold">
                                    @DisplayUserRole
                                </h5>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success">
                            @(string.IsNullOrEmpty(currentUser?.BasicStatusName) ? Translation.GetString("dashboard.status.active") : currentUser.BasicStatusName)
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="flex-shrink-0 bg-success bg-opacity-10 p-3 rounded text-success">
                                    <i class="bi bi-credit-card fs-4"></i>
                                </div>
                                <div class="ms-3">
                                    <h6 class="text-muted mb-1">@Translation.GetString("dashboard.current_subscription")</h6>
                                    <h5 class="mb-0 fw-semibold">
                                        @if (HasActiveSubscription)
                                        {
                                            @currentSubscription!.PlanName
                                        }
                                        else
                                        {
                                            @Translation.GetString("dashboard.subscription.none")
                                        }
                                    </h5>
                                </div>
                            </div>

                            @if (HasActiveSubscription)
                            {
                                <div class="mb-2">
                                    <span class="badge bg-success bg-opacity-10 text-success me-1">
                                        @Translation.GetString("dashboard.subscription.active")
                                    </span>
                                    @if (currentSubscription!.SubscriptionPeriod > 0)
                                    {
                                        <small class="text-muted">
                                            @Translation.GetString("dashboard.subscription.period_prefix") @currentSubscription.SubscriptionPeriod @Translation.GetString("dashboard.subscription.period_suffix")
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">
                                            @Translation.GetString("dashboard.subscription.period_free")
                                        </small>
                                    }
                                </div>

                                <div class="mt-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-muted">@Translation.GetString("dashboard.subscription.monthly_usage")</span>
                                        <span class="fw-semibold">
                                            @currentSubscription.PrintsUsedThisMonth / @currentSubscription.MonthlyPrintsIncluded
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar @GetUsageBarCssClass(currentSubscription)"
                                             role="progressbar"
                                             style="width: @GetUsagePercentage(currentSubscription)%"
                                             aria-valuenow="@currentSubscription.PrintsUsedThisMonth"
                                             aria-valuemin="0"
                                             aria-valuemax="@currentSubscription.MonthlyPrintsIncluded">
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted mt-2">
                                        <span>@Translation.GetString("dashboard.subscription.extra_prints"): <strong>+@currentSubscription.ExtraPrintsBalance</strong></span>
                                        <span>@Translation.GetString("dashboard.subscription.total_available"): <strong class="text-primary">@currentSubscription.TotalAvailablePrints</strong></span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2" @onclick="OpenSubscriptionModal">
                                    @Translation.GetString("dashboard.subscription.subscribe")
                                </button>
                            }
                        </div>

                        @if (HasActiveSubscription)
                        {
                            <div class="mt-3 pt-2 border-top d-flex flex-column gap-2">
                                @if (string.Equals(currentSubscription!.PlanCode, "free", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary w-100" @onclick="OpenSubscriptionModal">
                                        @Translation.GetString("account.subscription.change_plan_button")
                                    </button>
                                }

                                @if (currentSubscription.TopUpPrintsIncluded.HasValue && currentSubscription.TopUpPrice.HasValue)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-success w-100"
                                            disabled="@isProcessingTopUp"
                                            @onclick="HandleTopUpAsync">
                                        @if (isProcessingTopUp)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        }
                                        @Translation.GetString("dashboard.subscription.topup_button")
                                        (+@currentSubscription.TopUpPrintsIncluded.Value — @currentSubscription.TopUpPrice.Value.ToString("0.##") €)
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0 bg-warning bg-opacity-10 p-3 rounded text-warning">
                                <i class="bi bi-shield-lock fs-4"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="text-muted mb-1">@Translation.GetString("dashboard.security")</h6>
                                <h5 class="mb-0 fw-semibold">@Translation.GetString("dashboard.security_title")</h5>
                            </div>
                        </div>
                        <div class="mt-3 text-end">
                            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="NavigateToAccount">
                                @Translation.GetString("dashboard.manage_account")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h4 class="card-title mb-4">@Translation.GetString("dashboard.account_info")</h4>
                        @if (currentUser != null)
                        {
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <span class="text-muted">@Translation.GetString("dashboard.field.name")</span>
                                    <span class="fw-medium">@currentUser.Name</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <span class="text-muted">@Translation.GetString("dashboard.field.email")</span>
                                    <span class="fw-medium">@currentUser.Email</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <span class="text-muted">@Translation.GetString("dashboard.field.member_since")</span>
                                    <span class="fw-medium">@currentUser.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<SubscriptionModal @bind-IsVisible="_showSubscriptionModal"
                   CurrentPlanCode="@currentSubscription?.PlanCode"
                   OnSubscriptionChanged="RefreshSubscriptionAsync" />

@code {
    private bool isLoading = true;
    private bool isProcessingTopUp = false;
    private bool _showSubscriptionModal = false;
    private UserDto? currentUser;
    private SubscriptionDto? currentSubscription;

    private bool HasActiveSubscription =>
        currentSubscription != null && !string.IsNullOrEmpty(currentSubscription.PlanName);

    private string DisplayUserRole => currentUser?.IsAdmin == true
        ? Translation.GetString("dashboard.role.admin")
        : (currentUser?.IsReseller == true 
            ? Translation.GetString("dashboard.role.reseller") 
            : Translation.GetString("dashboard.role.user"));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var userTask = ApiClient.GetFromJsonAsync<UserDto>("api/users/me");
            var subscriptionTask = ApiClient.GetFromJsonAsync<SubscriptionDto>("api/account/subscriptions/current");

            await Task.WhenAll(userTask, subscriptionTask);

            currentUser = userTask.Result;
            currentSubscription = subscriptionTask.Result;
        }
        catch (Exception ex)
        {
            string error = Translation.GetString("app.error.unknown");
            Logger.LogError(ex, error);
            ToastService.ShowError(error);
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            HandleStripeRedirect();
        }
    }

    private void OpenSubscriptionModal()
    {
        _showSubscriptionModal = true;
    }

    private async Task RefreshSubscriptionAsync()
    {
        try
        {
            currentSubscription = await ApiClient.GetFromJsonAsync<SubscriptionDto>("api/account/subscriptions/current");
        }
        catch (Exception ex)
        {
            string error = Translation.GetString("app.error.unknown");
            Logger.LogError(ex, error);
            ToastService.ShowError(error);
        }
    }

    private static int GetUsagePercentage(SubscriptionDto sub)
    {
        if (sub.MonthlyPrintsIncluded <= 0)
            return 0;

        var pct = (int)Math.Round((double)sub.PrintsUsedThisMonth / sub.MonthlyPrintsIncluded * 100);
        return Math.Clamp(pct, 0, 100);
    }

    private static string GetUsageBarCssClass(SubscriptionDto sub)
    {
        var pct = GetUsagePercentage(sub);
        if (pct >= 90) return "bg-danger";
        if (pct >= 75) return "bg-warning";
        return "bg-primary";
    }

    private async Task HandleTopUpAsync()
    {
        isProcessingTopUp = true;
        try
        {
            // TODO: appeler l'endpoint CheckoutSession pour le Top-Up et rediriger vers Stripe
        }
        finally
        {
            isProcessingTopUp = false;
        }
    }

    private void HandleStripeRedirect()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var path = uri.AbsolutePath.TrimEnd('/');

        if (path.EndsWith("/dashboard/subscription/success", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.ShowSuccess(Translation.GetString("dashboard.subscription.checkout_success"));
            Navigation.NavigateTo("/dashboard", replace: true);
        }
        else if (path.EndsWith("/dashboard/subscription/cancel", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.ShowWarning(Translation.GetString("dashboard.subscription.checkout_cancel"));
            Navigation.NavigateTo("/dashboard", replace: true);
        }
    }

    private void NavigateToAccount()
    {
        Navigation.NavigateTo("/account");
    }
}