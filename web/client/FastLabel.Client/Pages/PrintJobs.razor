@page "/printjobs"
@layout MainLayout
@attribute [Authorize]
@inject TranslationService Translation

<CrudTablePage @ref="_crudTable"
               TItem="PrintJobsDto" 
               TKey="int"
               ApiEndpoint="api/printjobs"
               IdSelector="h => h.Id"
               IsReadOnly="true"
               Title="@Translation.GetString("printjobs.title")"
               Description="@Translation.GetString("printjobs.description")"
               EmptyMessage="@Translation.GetString("printjobs.no_printjobs")">

    <TableHeader>
        @if (_isAdmin)
        {
            <th role="button" @onclick='() => SortAsync("UserName")'>
                @Translation.GetString("printjobs.user") <i class="bi bi-arrow-down-up small text-muted"></i>
            </th>
        }
        <th role="button" @onclick='() => SortAsync("PrinterName")'>
            @Translation.GetString("printjobs.printer") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("TemplateName")'>
            @Translation.GetString("printjobs.template") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("Quantity")'>
            @Translation.GetString("printjobs.quantity") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th>@Translation.GetString("printjobs.status")</th>
        <th role="button" @onclick='() => SortAsync("CreatedAt")'>
            @Translation.GetString("printjobs.date") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
    </TableHeader>

    <TableFilters>
        @if (_isAdmin)
        {
            <th>
                <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                       @oninput='e => FilterAsync("filterByUser", e.Value?.ToString())' />
            </th>
        }
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                   @oninput='e => FilterAsync("filterByPrinter", e.Value?.ToString())' />
        </th>
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                   @oninput='e => FilterAsync("filterByTemplate", e.Value?.ToString())' />
        </th>
        <th></th>
        <th></th>
        <th></th>
    </TableFilters>

    <RowTemplate Context="item">
        @if (_isAdmin)
        {
            <td>@item.UserName</td>
        }
        <td>@item.PrinterName</td>
        <td>@item.TemplateName</td>
        <td>@item.Quantity</td>
        <td>
            <span class="badge bg-@(string.IsNullOrEmpty(item.ResponseMessage) ? "success" : "warning")">
                @(string.IsNullOrEmpty(item.ResponseMessage) ? Translation.GetString("printjobs.status.success") : Translation.GetString("printjobs.status.error"))
            </span>
        </td>
        <td>@(item.ProcessedAt?.ToLocalTime().ToString("g") ?? item.CreatedAt.ToLocalTime().ToString("g"))</td>
    </RowTemplate>

</CrudTablePage>

@code {
    private CrudTablePage<PrintJobsDto, int>? _crudTable;
    private bool _isAdmin;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var authState = await AuthStateTask;
        var user = authState.User;
        _isAdmin = user.IsInRole("Admin");
    }

    private async Task SortAsync(string columnName)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplySortAsync(columnName);
        }
    }

    private async Task FilterAsync(string columnName, string? value)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplyFilterAsync(columnName, value ?? string.Empty);
        }
    }
}