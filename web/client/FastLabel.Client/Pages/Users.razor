@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inject TranslationService Translation
@implements IDisposable
@using Microsoft.AspNetCore.Authorization

<div class="container-fluid">
    <h3>@Translation.GetString("users.title")</h3>
    <p class="text-muted">@Translation.GetString("users.description")</p>
    
    <div class="alert alert-secondary" role="alert">
        @Translation.GetString("users.no_users")
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Translation.OnChange += OnTranslationChanged;
    }

    private void OnTranslationChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Translation.OnChange -= OnTranslationChanged;
    }
}