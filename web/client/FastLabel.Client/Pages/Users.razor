@page "/users"
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]
@inject TranslationService Translation

<CrudTablePage @ref="_crudTable"
               TItem="UserDto" 
               TKey="int"
               ApiEndpoint="api/users"
               IdSelector="u => u.Id"
               CreateNewItem="@(() => new UserDto())"
               Title="@Translation.GetString("users.title")"
               Description="@Translation.GetString("users.description")"
               EmptyMessage="@Translation.GetString("users.no_users")"
               AddModalTitle="@Translation.GetString("users.add_title")"
               EditModalTitle="@Translation.GetString("users.edit_title")">

    <TableHeader>
        <th role="button" @onclick='() => SortAsync("Name")'>
            @Translation.GetString("users.name") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("Email")'>
            @Translation.GetString("users.email") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("Role")'>
            @Translation.GetString("users.role") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("ResellerName")'>
            @Translation.GetString("users.reseller") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("BasicStatusName")'>
            @Translation.GetString("users.status") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
        <th role="button" @onclick='() => SortAsync("CreatedAt")'>
            @Translation.GetString("users.created_at") <i class="bi bi-arrow-down-up small text-muted"></i>
        </th>
    </TableHeader>

    <TableFilters>
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                   @oninput='e => FilterAsync("filterByName", e.Value?.ToString())' />
        </th>
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                   @oninput='e => FilterAsync("filterByEmail", e.Value?.ToString())' />
        </th>
        <th></th>
        <th>
            <input type="text" class="form-control form-control-sm" placeholder="Filtrer..." 
                   @oninput='e => FilterAsync("filterByReseller", e.Value?.ToString())' />
        </th>
        <th></th>
        <th></th>
    </TableFilters>

    <RowTemplate Context="user">
        <td>@user.Name</td>
        <td>@user.Email</td>
        <td>
            <span class="badge bg-@(user.IsAdmin ? "danger" : (user.IsReseller ? "warning text-dark" : "secondary"))">
                @(user.IsAdmin ? Translation.GetString("users.role_admin") : (user.IsReseller ? Translation.GetString("users.role_reseller") : Translation.GetString("users.role_user")))
            </span>
        </td>
        <td>
            @if (!string.IsNullOrEmpty(user.ResellerName))
            {
                <span class="text-muted small"><i class="bi bi-shop me-1"></i>@user.ResellerName</span>
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td>
            <span class="badge bg-light text-dark border">
                @user.BasicStatusName
            </span>
        </td>
        <td>@user.CreatedAt.ToLocalTime().ToString("d")</td>
    </RowTemplate>

    <FormFields Context="user">
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("users.name")</label>
            <InputText class="form-control" @bind-Value="user.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("users.email")</label>
            <InputText class="form-control" @bind-Value="user.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("users.password")</label>
            <div class="input-group">
                <InputText type="@(_showPassword ? "text" : "password")" class="form-control" @bind-Value="user.Password" />
                <button type="button" class="btn btn-outline-secondary" style="border-color: #ced4da;" @onclick="TogglePasswordVisibility">
                    <i class="bi bi-@(_showPassword ? "eye-slash" : "eye")"></i>
                </button>
            </div>
            <small class="form-text text-muted">@Translation.GetString("users.password_help")</small>
        </div>
        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" id="isAdminCheck" @bind-Value="user.IsAdmin" />
            <label class="form-check-label" for="isAdminCheck">
                @Translation.GetString("users.is_admin")
            </label>
        </div>
        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" id="isResellerCheck" @bind-Value="user.IsReseller" />
            <label class="form-check-label" for="isResellerCheck">
                @Translation.GetString("users.is_reseller")
            </label>
        </div>
    </FormFields>

</CrudTablePage>

@code {
    private CrudTablePage<UserDto, int>? _crudTable;
    private bool _showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task SortAsync(string columnName)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplySortAsync(columnName);
        }
    }

    private async Task FilterAsync(string columnName, string? value)
    {
        if (_crudTable != null)
        {
            await _crudTable.ApplyFilterAsync(columnName, value ?? string.Empty);
        }
    }
}