@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inherits TranslatableComponent
@using FastLabel.Client.Components
@using FastLabel.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory ClientFactory

<div class="container-fluid">
    <h3 class="mb-3">@Translation.GetString("users.title")</h3>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Translation.GetString("common.loading")</span>
            </div>
        </div>
    }
    else if (_users == null || !_users.Any())
    {
        <p class="text-muted">@Translation.GetString("users.description")</p>
    
        <div class="alert alert-secondary" role="alert">
            @Translation.GetString("users.no_users")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>@Translation.GetString("users.name")</th>
                        <th>@Translation.GetString("users.email")</th>
                        <th>@Translation.GetString("users.role")</th>
                        <th>@Translation.GetString("users.created_at")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        <tr>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge bg-@(user.IsAdmin ? "danger" : "secondary")">
                                    @(user.IsAdmin ? "Admin" : "User")
                                </span>
                            </td>
                            <td>@user.CreatedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<UserDto> _users = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        try
        {
            var client = ClientFactory.CreateClient("AuthClient");
            _users = await client.GetFromJsonAsync<List<UserDto>>("api/users") ?? new();
        }
        catch (Exception)
        {
            _users = new();
        }
        finally
        {
            isLoading = false;
        }
    }
}