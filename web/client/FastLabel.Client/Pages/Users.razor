@page "/users"
@layout MainLayout
@attribute [Authorize(Roles = "Admin")]
@inherits TranslatableComponent

<CrudTablePage @ref="_crudTable"
               TItem="UserDto" 
               TKey="int"
               ApiEndpoint="api/users"
               IdSelector="u => u.Id"
               CreateNewItem="@(() => new UserDto())"
               Title="@Translation.GetString("users.title")"
               Description="@Translation.GetString("users.description")"
               EmptyMessage="@Translation.GetString("users.no_users")"
               AddModalTitle="@Translation.GetString("users.add_title")"
               EditModalTitle="@Translation.GetString("users.edit_title")">

    <TableHeader>
        <th>@Translation.GetString("users.name")</th>
        <th>@Translation.GetString("users.email")</th>
        <th>@Translation.GetString("users.role")</th>
        <th>@Translation.GetString("users.created_at")</th>
    </TableHeader>

    <RowTemplate Context="user">
        <td>@user.Name</td>
        <td>@user.Email</td>
        <td>
            <span class="badge bg-@(user.IsAdmin ? "danger" : "secondary")">
                @(user.IsAdmin ? "Admin" : "User")
            </span>
        </td>
        <td>@user.CreatedAt.ToLocalTime().ToString("g")</td>
    </RowTemplate>

    <FormFields Context="user">
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("users.name")</label>
            <InputText class="form-control" @bind-Value="user.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Translation.GetString("users.email")</label>
            <InputText class="form-control" @bind-Value="user.Email" />
        </div>
        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" id="isAdminCheck" @bind-Value="user.IsAdmin" />
            <label class="form-check-label" for="isAdminCheck">
                @Translation.GetString("users.is_admin")
            </label>
        </div>
    </FormFields>

</CrudTablePage>

@code {
    private CrudTablePage<UserDto, int>? _crudTable;

    protected override async Task OnLanguageChangedAsync()
    {
        StateHasChanged();
        if (_crudTable != null)
        {
            await _crudTable.LoadDataAsync();
        }
    }
}