@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inherits TranslatableComponent
@using FastLabel.Client.Components
@using Microsoft.AspNetCore.Authorization

<div class="container-fluid">
    <h3>@Translation.GetString("users.title")</h3>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Translation.GetString("account.loading")</span>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted">@Translation.GetString("users.description")</p>
    
        <div class="alert alert-secondary" role="alert">
            @Translation.GetString("users.no_users")
        </div>
    }
</div>

@code {
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
        }
        catch (Exception)
        {
        }
        finally
        {
            isLoading = false;
        }
    }
}