@page "/reset-password"
@inherits TranslatableComponent
@layout PublicLayout
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@implements IDisposable
@using FastLabel.Client.Components
@using FastLabel.Client.Components.Layout
@using FastLabel.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<div class="d-flex justify-content-center align-items-center w-100">
    <div style="width: 100%; max-width: 420px;">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">@Translation.GetString("auth.reset_password_title")</h3>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @_errorMessage
                    </div>
                }

                @if (string.IsNullOrEmpty(_token))
                {
                    <div class="alert alert-warning" role="alert">
                        @Translation.GetString("auth.error.missing_token")
                    </div>
                }
                else
                {
                    <EditForm Model="_model" OnValidSubmit="HandleResetPassword">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">@Translation.GetString("auth.new_password")</label>
                            <div class="input-group">
                                <input type="@PasswordInputType" 
                                       @bind="_model.NewPassword" 
                                       @bind:event="oninput"
                                       class="form-control"
                                       placeholder="••••••••" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordVisibility">
                                    <i class="bi @PasswordIconClass" style="pointer-events: none;"></i>
                                </button>
                            </div>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                                @if (_isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>@Translation.GetString("auth.processing")</span>
                                }
                                else
                                {
                                    <span>@Translation.GetString("auth.submit")</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private ResetPasswordDto _model = new();
    private string? _errorMessage;
    private bool _isLoading = false;
    private bool _showPassword = false;
    private string? _token;

    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenParam { get; set; }

    private string PasswordInputType => _showPassword ? "text" : "password";
    private string PasswordIconClass => _showPassword ? "bi-eye-slash" : "bi-eye";

    protected override void OnParametersSet()
    {
        _token = TokenParam;
        if (!string.IsNullOrEmpty(_token))
        {
            _model.Token = _token;
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleResetPassword()
    {
        _errorMessage = null;

        if (string.IsNullOrEmpty(_model.Token))
        {
            _errorMessage = Translation.GetString("auth.error.missing_token");
            return;
        }

        _isLoading = true;

        try
        {
            var client = ClientFactory.CreateClient("PublicClient");
            var response = await client.PostAsJsonAsync("api/auth/reset-password", _model);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/?pwupdated=true");
            }
            else
            {
                var errorContent = await response.Content.ReadFromJsonAsync<ErrorResponseDto>();
                string errorKey = !string.IsNullOrEmpty(errorContent?.Message) ? errorContent.Message : "auth.error.general";
                _errorMessage = Translation.GetString(errorKey);
            }
        }
        catch (Exception)
        {
            _errorMessage = Translation.GetString("auth.error.server_unreachable");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}