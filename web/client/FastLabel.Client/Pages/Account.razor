@page "/account"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<PageTitle>FastLabel - Mon Compte</PageTitle>

<div class="container mt-4">
    <h2>Mon Compte</h2>
    <hr />

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Informations Profil -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Informations personnelles</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label text-muted">Adresse Email</label>
                            <input type="text" class="form-control" value="@userEmail" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted">Rôle / Plan</label>
                            <input type="text" class="form-control" value="@userRole" disabled />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Préférences et Paramètres -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Préférences utilisateur</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success" role="alert">
                                @successMessage
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @errorMessage
                            </div>
                        }

                        <EditForm Model="@preferencesModel" OnValidSubmit="SavePreferences">
                            <DataAnnotationsValidator />

                            <div class="mb-3 form-check">
                                <InputCheckbox id="emailNotifications" class="form-check-input" @bind-Value="preferencesModel.ReceiveEmailNotifications" />
                                <label class="form-check-label" for="emailNotifications">
                                    Recevoir les notifications par email
                                </label>
                            </div>

                            <div class="mb-3">
                                <label for="defaultPrinter" class="form-label">Imprimante ZPL par défaut</label>
                                <InputText id="defaultPrinter" class="form-control" @bind-Value="preferencesModel.DefaultPrinterName" placeholder="Ex: Zebra ZD420" />
                            </div>

                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Enregistrement...</span>
                                }
                                else
                                {
                                    <span>Enregistrer les modifications</span>
                                }
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private bool isLoading = true;
    private bool isSaving = false;
    private string userEmail = string.Empty;
    private string userRole = "Standard";
    private string? successMessage;
    private string? errorMessage;

    private UserPreferencesModel preferencesModel = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                userEmail = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value 
                          ?? user.Identity.Name 
                          ?? "Utilisateur";
                
                var roleClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Role);
                if (roleClaim != null)
                {
                    userRole = roleClaim.Value;
                }
            }

            preferencesModel.ReceiveEmailNotifications = true;
            preferencesModel.DefaultPrinterName = "Zebra ZT230";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement du profil : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SavePreferences()
    {
        isSaving = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            await Task.Delay(600); 
            successMessage = "Vos préférences ont été enregistrées avec succès.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Une erreur est survenue lors de l'enregistrement : {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    public class UserPreferencesModel
    {
        public bool ReceiveEmailNotifications { get; set; }
        public string DefaultPrinterName { get; set; } = string.Empty;
    }
}