@page "/account"
@layout MainLayout
@attribute [Authorize]
@inherits TranslatableComponent
@inject ApiClient ApiClient
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="container mt-4">
    <h2>@Translation.GetString("account.title")</h2>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Translation.GetString("common.loading")</span>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label text-muted">@Translation.GetString("account.name_label")</label>
                            <input type="text" class="form-control" value="@userName" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted">@Translation.GetString("account.email_label")</label>
                            <input type="text" class="form-control" value="@userEmail" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted">@Translation.GetString("account.role_label")</label>
                            <input type="text" class="form-control" value="@DisplayUserRole" disabled />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string userEmail = string.Empty;
    private string userName = string.Empty;
    private string userRole = string.Empty;

    private string DisplayUserRole => userRole.ToLower() switch
    {
        "admin" => Translation.GetString("users.role_admin"),
        _ => Translation.GetString("users.role_user")
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var emailClaim = user.FindFirst(ClaimTypes.Email) ?? user.FindFirst("email");
            if (emailClaim != null)
            {
                userEmail = emailClaim.Value;
            }

            var roleClaim = user.FindFirst(ClaimTypes.Role) ?? user.FindFirst("role");
            if (roleClaim != null)
            {
                userRole = roleClaim.Value;
            }

            var nameClaim = user.FindFirst(ClaimTypes.Name) ?? user.FindFirst("name") ?? user.FindFirst(ClaimTypes.GivenName);
            if (nameClaim != null)
            {
                userName = nameClaim.Value;
            }
        }
        catch (Exception)
        {
            ToastService.ShowError(Translation.GetString("app.error.unknown"));
            Navigation.NavigateTo("/");
        }
        finally
        {
            isLoading = false;
        }
    }
}