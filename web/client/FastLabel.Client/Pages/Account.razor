@page "/account"
@attribute [Authorize]
@inherits TranslatableComponent
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="container mt-4">
    <h2>@Translation.GetString("account.title")</h2>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Translation.GetString("common.loading")</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label text-muted">@Translation.GetString("account.name_label")</label>
                            <input type="text" class="form-control" value="@userName" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted">@Translation.GetString("account.email_label")</label>
                            <input type="text" class="form-control" value="@userEmail" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted">@Translation.GetString("account.role_label")</label>
                            <input type="text" class="form-control" value="@userRole" disabled />
                        </div>
                    </div>
                </div>
            </div>

            
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string userEmail = string.Empty;
    private string userName = string.Empty;
    private string userRole = "Standard";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var claimsData = user.Claims.Select(c => new { c.Type, c.Value });

            var emailClaim = user.FindFirst("email");
            if (emailClaim != null)
            {
                userEmail =  emailClaim.Value;
            }

            var roleClaim = user.FindFirst(c => c.Type == ClaimTypes.Role);
            if (roleClaim != null)
            {
                userRole = roleClaim.Value;
            }

            var nameClaim = user.FindFirst("unique_name");
            if (nameClaim != null)
            {
                userName =  nameClaim.Value;
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized || ex.StatusCode == HttpStatusCode.Forbidden)
        {
            Navigation.NavigateTo("/");
        }
        finally
        {
            isLoading = false;
        }
    }
}