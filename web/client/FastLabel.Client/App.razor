@inject NavigationManager Navigation
@inject TranslationService TranslationService

<HeadOutlet />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData">
                <Authorizing>
                </Authorizing>
                <NotAuthorized>
                    <PageTitle>FastLabel - @TranslationService.GetString("auth.error.unauthorized_title")</PageTitle>
                    <LayoutView Layout="@typeof(PublicLayout)">
                        <div class="container mt-5 text-center">
                            <h3>@TranslationService.GetString("auth.error.unauthorized_title")</h3>
                            <p>@TranslationService.GetString("auth.error.unauthorized_message")</p>
                            <button class="btn btn-primary mt-3" @onclick="NavigateToLogin">
                                @TranslationService.GetString("auth.login_title")
                            </button>
                        </div>
                    </LayoutView>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <PageTitle>FastLabel - @TranslationService.GetString("error.not_found_title")</PageTitle>
            <LayoutView Layout="@typeof(PublicLayout)">
                <div class="container mt-5 text-center">
                    <h3>@TranslationService.GetString("error.not_found_title")</h3>
                    <p>@TranslationService.GetString("error.not_found_message")</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/");
    }
}