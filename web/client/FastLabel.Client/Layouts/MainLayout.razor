@inherits TranslatableComponent
@inject AuthService AuthService
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject ToastService ToastService

<PageTitle>FastLabel - @GetCurrentPageTitle()</PageTitle>

@if (!_isLoaded)
{
    <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="app-container d-flex flex-column vh-100">
        <header class="navbar navbar-dark bg-dark px-3 shadow-sm d-flex justify-content-between align-items-center"
                style="z-index: 1050;">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-sm d-md-none text-white border-secondary" type="button"
                        @onclick="ToggleSidebar">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <NavLink class="navbar-brand fw-bold text-white text-decoration-none" href="/home">
                    FastLabel
                </NavLink>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <AuthorizeView Roles="Admin">
                    <NavLink class="btn btn-outline-light btn-sm" href="/admin">
                        <i class="bi bi-shield-lock me-1"></i> @Translation.GetString("nav.admin_dashboard")
                    </NavLink>
                </AuthorizeView>

                <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right"></i> @Translation.GetString("nav.logout")
                </button>
            </div>
        </header>

        <div class="d-flex flex-grow-1 overflow-hidden position-relative">
            @if (_isSidebarOpen)
            {
                <div class="modal-backdrop fade show d-md-none" @onclick="ToggleSidebar" style="z-index: 1039;"></div>
            }

            <nav class="app-sidebar bg-light border-end p-3 d-flex flex-column @(_isSidebarOpen ? "show" : "")">
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item">
                        <NavLink class="nav-link text-dark" href="/templates" Match="NavLinkMatch.Prefix"
                                 @onclick="CloseSidebarOnMobile">
                            <i class="bi bi-file-earmark-text me-2"></i> @Translation.GetString("nav.templates")
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-dark" href="/printers" Match="NavLinkMatch.Prefix"
                                 @onclick="CloseSidebarOnMobile">
                            <i class="bi bi-printer me-2"></i> @Translation.GetString("nav.printers")
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-dark" href="/agents" Match="NavLinkMatch.Prefix"
                                 @onclick="CloseSidebarOnMobile">
                            <i class="bi bi-pc-display me-2"></i> @Translation.GetString("nav.agents")
                        </NavLink>
                    </li>
                    <AuthorizeView Roles="Admin">
                        <li class="nav-item">
                            <NavLink class="nav-link text-dark" href="/users" Match="NavLinkMatch.Prefix"
                                     @onclick="CloseSidebarOnMobile">
                                <i class="bi bi-people me-2"></i> @Translation.GetString("nav.users")
                            </NavLink>
                        </li>
                    </AuthorizeView>
                    
                    <AuthorizeView Roles="Reseller">
                        <li class="nav-item">
                            <NavLink class="nav-link text-dark" href="/clients" Match="NavLinkMatch.Prefix"
                                     @onclick="CloseSidebarOnMobile">
                                <i class="bi bi-shop me-2"></i> @Translation.GetString("nav.clients")
                            </NavLink>
                        </li>
                    </AuthorizeView>

                    <li class="nav-item">
                        <NavLink class="nav-link text-dark" href="/printjobs" Match="NavLinkMatch.Prefix"
                                 @onclick="CloseSidebarOnMobile">
                            <i class="bi bi-clock-history me-2"></i> @Translation.GetString("nav.printjobs")
                        </NavLink>
                    </li>
                </ul>
            </nav>

            <main class="flex-grow-1 p-4 overflow-y-auto bg-white position-relative">
                @Body
            </main>
        </div>
    </div>

    <ToastContainer />
}

@code {
    private bool _isLoaded = false;
    private bool _isSidebarOpen = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ApiClient.GetFromJsonAsync<UserDto>("api/users/me");
        }
        catch (Exception ex)
        {
            AppLog.Error(ex);
            ToastService.ShowError(Translation.GetString("app.error.unknown"));
        }

        try
        {
            await Translation.InitializeAsync();
        }
        catch (Exception ex)
        {
            AppLog.Error(ex);
            ToastService.ShowError(Translation.GetString("app.error.unknown"));
        }
        
        _isLoaded = true;
        StateHasChanged();
    }

    private string GetCurrentPageTitle()
    {
        var uri = Navigation.Uri.ToLower();

        if (uri.Contains("/home")) return Translation.GetString("nav.home");
        if (uri.Contains("/admin")) return Translation.GetString("nav.admin_dashboard");
        if (uri.Contains("/account")) return Translation.GetString("nav.my_account");
        if (uri.Contains("/templates")) return Translation.GetString("nav.templates");
        if (uri.Contains("/printers")) return Translation.GetString("nav.printers");
        if (uri.Contains("/agents")) return Translation.GetString("nav.agents");
        if (uri.Contains("/users")) return Translation.GetString("nav.users");
        if (uri.Contains("/clients")) return Translation.GetString("clients.title");
        if (uri.Contains("/printjobs")) return Translation.GetString("nav.printjobs");

        return Translation.GetString("nav.home");
    }

    private void ToggleSidebar() => _isSidebarOpen = !_isSidebarOpen;

    private void CloseSidebarOnMobile()
    {
        if (_isSidebarOpen)
        {
            _isSidebarOpen = false;
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();

        Navigation.NavigateTo("/");
    }
}