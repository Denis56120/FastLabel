@inherits TranslatableComponent
@inject NavigationManager Navigation
@inject ApiClient ApiClient
@inject ToastService ToastService
@inject ILogger Logger

@if (!_isLoaded)
{
    <PageTitle>FastLabel - @Translation.GetString("common.loading")</PageTitle>
    <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Translation.GetString("common.loading")</span>
        </div>
    </div>
}
else
{
    <PageTitle>FastLabel - @GetSafePageTitle()</PageTitle>
    <div class="d-flex flex-column min-vh-100 bg-light position-relative">
        <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" href="/">FastLabel</a>

                <div class="d-flex align-items-center">
                    <div class="dropdown @(_isDropdownOpen ? "show" : "")">
                        <button class="btn btn-outline-secondary dropdown-toggle btn-sm d-flex align-items-center gap-1"
                                type="button" @onclick="ToggleDropdown">
                            @if (!string.IsNullOrEmpty(CurrentLanguageFlag))
                            {
                                <span>@CurrentLanguageFlag</span>
                            }
                            else
                            {
                                <i class="bi bi-globe"></i>
                            }
                            <span>@CurrentLanguageDescription</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow-sm @(_isDropdownOpen ? "show" : "")"
                            style="position: absolute; right: 0; left: auto;">
                            @if (_languages != null)
                            {
                                @foreach (var lang in _languages)
                                {
                                    var isCurrent = Translation.CurrentLanguage.Equals(lang.Code,
                        StringComparison.OrdinalIgnoreCase);
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 @(isCurrent ? "active" : "")"
                                                type="button" @onclick='() => ChangeLanguage(lang.Code)'>
                                            @if (!string.IsNullOrEmpty(lang.Flag))
                                            {
                                                <span>@lang.Flag</span>
                                            }
                                            <span>@lang.Description</span>
                                        </button>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <div class="container d-flex justify-content-center align-items-center flex-grow-1 py-4">
            <div class="w-100" style="max-width: 450px;">
                @Body
            </div>
        </div>

        <ToastContainer />
    </div>
}

@code {
    private bool _isDropdownOpen = false;
    private bool _isLoaded = false;
    private List<LanguageDto>? _languages;

    private LanguageDto? CurrentLanguageObj =>
        _languages?.FirstOrDefault(l => l.Code.Equals(Translation.CurrentLanguage, StringComparison.OrdinalIgnoreCase));

    private string CurrentLanguageDescription => CurrentLanguageObj?.Description ?? "Language";
    private string? CurrentLanguageFlag => CurrentLanguageObj?.Flag;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        try
        {
            await ApiClient.GetAsync("api/antiforgery/token");
            await Translation.InitializeAsync();
            await LoadLanguagesAsync();
        }
        catch (Exception ex)
        {
            string error = Translation.GetString("app.error.unknown");
            Logger.LogError(ex, error);
            ToastService.ShowError(error);
        }

        _isLoaded = true;
        StateHasChanged();
    }

    private async Task LoadLanguagesAsync()
    {
        try
        {
            _languages = await ApiClient.GetFromJsonAsync<List<LanguageDto>>("api/languages") ?? new();
        }
        catch (Exception ex)
        {
            _languages = new();

            string error = Translation.GetString("app.error.unknown");
            Logger.LogError(ex, error);
            ToastService.ShowError(error);
        }
    }

    private string GetSafePageTitle()
    {
        var uri = Navigation.Uri.ToLower();

        string key = uri switch
        {
            var u when u.Contains("/register") => "auth.register_title",
            var u when u.Contains("/forgot-password") => "auth.forgot_heading",
            var u when u.Contains("/reset-password") => "auth.reset_password_title",
            _ => "auth.login_title"
        };

        return Translation.GetString(key);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Navigation.LocationChanged -= OnLocationChanged;
        }

        base.Dispose(disposing);
    }

    private void ToggleDropdown()
    {
        _isDropdownOpen = !_isDropdownOpen;
    }

    private async Task ChangeLanguage(string languageCode)
    {
        _isDropdownOpen = false;

        try
        {
            await Translation.SetLanguageAsync(languageCode);
        }
        catch (Exception ex)
        {
            string error = Translation.GetString("app.error.unknown");
            Logger.LogError(ex, error);
            ToastService.ShowError(error);
        }

        if (_languages is null or { Count: 0 })
        {
            await LoadLanguagesAsync();
        }
    }
}