@typeparam TItem where TItem : class, new()
@typeparam TKey where TKey : notnull
@inject TranslationService Translation
@inject ApiClient ApiClient
@inject ToastService ToastService
@inject ILogger<CrudTablePage<TItem, TKey>> Logger

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">@Title</h3>
            @if (!string.IsNullOrEmpty(Description))
            {
                <small class="text-muted">@Description</small>
            }
        </div>
        
        <div class="d-flex align-items-center gap-2">
            @if (CustomToolbarActions != null && _selectedIds.Count == 1)
            {
                var selectedId = _selectedIds.First();
                var selectedItem = _items.FirstOrDefault(i => EqualityComparer<TKey>.Default.Equals(IdSelector(i), selectedId));
                if (selectedItem != null)
                {
                    @CustomToolbarActions(selectedItem)
                }
            }

            @if (!IsReadOnly)
            {
                <div class="btn-group" role="group">
                    @if (!DisableAdd)
                    {
                        <button type="button" class="btn btn-primary btn-sm" disabled="@(_isSaving || _isDeleting)" @onclick="OpenAddModal">
                            <i class="bi bi-plus-lg"></i> @Translation.GetString("common.add")
                        </button>
                    }
                    @if (!DisableEdit)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_selectedIds.Count != 1 || _isSaving || _isDeleting)"
                                @onclick="OpenEditModal">
                            <i class="bi bi-pencil"></i> @Translation.GetString("common.edit")
                        </button>
                    }
                    @if (!DisableDelete)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(_selectedIds.Count == 0 || _isSaving || _isDeleting)"
                                @onclick="DeleteSelectedAsync">
                            <i class="bi bi-trash"></i> @Translation.GetString("common.delete") (@_selectedIds.Count)
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Zone de filtres globaux personnalisés injectée par la page parente -->
    @if (ToolbarFilters != null)
    {
        <div class="mb-3">
            @ToolbarFilters
        </div>
    }

    <!-- Encapsulation dans le ServerTable unifié -->
    <ServerTable @ref="_table" TItem="TItem" Title="" Description="" EmptyMessage="@EmptyMessage"
                 ApiEndpoint="@ApiEndpoint" EnableFiltering="@EnableFiltering" Items="_items" ItemsChanged="OnItemsChanged">

        <TableHeader>
            @if (!IsReadOnly && (!DisableEdit || !DisableDelete))
            {
                <th style="width: 40px;">
                    <input type="checkbox" class="form-check-input" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                </th>
            }
            @TableHeader
        </TableHeader>

        <TableFilters>
            @if (!IsReadOnly && (!DisableEdit || !DisableDelete))
            {
                <th></th>
            }
            @TableFilters
        </TableFilters>

        <RowTemplate Context="item">
            @{
                var id = IdSelector(item);
            }
            @if (!IsReadOnly && (!DisableEdit || !DisableDelete))
            {
                <td>
                    <input type="checkbox" class="form-check-input" checked="@_selectedIds.Contains(id)"
                           @onchange="(e) => ToggleSelection(id, e.Value)" />
                </td>
            }
            @RowTemplate(item)
        </RowTemplate>

    </ServerTable>
</div>

@if (!IsReadOnly)
{
    <BaseModal IsOpen="@_isModalOpen" Title="@(_isEditMode ? EditModalTitle : AddModalTitle)" EditContext="@_editContext"
               OnSave="SaveItemAsync" OnClose="CloseModal">
        @if (_editContext != null && FormFields != null)
        {
            <EditForm EditContext="@_editContext">
                <DataAnnotationsValidator />
                @FormFields(_currentItem)
            </EditForm>
        }
    </BaseModal>
}

@code {
    [Parameter, EditorRequired] public string ApiEndpoint { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Func<TItem, TKey> IdSelector { get; set; } = default!;
    [Parameter] public Func<TItem>? CreateNewItem { get; set; }
    [Parameter] public Func<TItem, TItem>? CloneItem { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = string.Empty;
    [Parameter] public string AddModalTitle { get; set; } = string.Empty;
    [Parameter] public string EditModalTitle { get; set; } = string.Empty;
    
    [Parameter, EditorRequired] public RenderFragment TableHeader { get; set; } = default!;
    [Parameter] public RenderFragment? TableFilters { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    [Parameter] public RenderFragment<TItem>? FormFields { get; set; }
    [Parameter] public RenderFragment<TItem>? CustomToolbarActions { get; set; }
    [Parameter] public RenderFragment? ToolbarFilters { get; set; }

    [Parameter] public bool EnableFiltering { get; set; } = true;
    [Parameter] public bool IsReadOnly { get; set; } = false;
    [Parameter] public bool DisableAdd { get; set; } = false;
    [Parameter] public bool DisableEdit { get; set; } = false;
    [Parameter] public bool DisableDelete { get; set; } = false;
    [Parameter] public bool UseBatchForSingleDelete { get; set; } = false;

    private ServerTable<TItem>? _table;
    private List<TItem> _items = new();
    private HashSet<TKey> _selectedIds = new();
    private bool _isModalOpen = false;
    private bool _isEditMode = false;
    private bool _isSaving = false;
    private bool _isDeleting = false;
    private TItem _currentItem = new();
    private EditContext? _editContext;

    private bool IsAllSelected => _items.Count > 0 && _items.All(i => _selectedIds.Contains(IdSelector(i)));

    private Task OnItemsChanged(List<TItem> newItems)
    {
        _items = newItems ?? new();
        var visibleIds = _items.Select(IdSelector).ToHashSet();
        _selectedIds.RemoveWhere(id => !visibleIds.Contains(id));
        return Task.CompletedTask;
    }

    /// <summary>
    /// Permet de forcer un rafraîchissement des données depuis la table serveur.
    /// </summary>
    public async Task RefreshAsync()
    {
        _selectedIds.Clear();
        if (_table != null)
        {
            await _table.LoadDataAsync();
        }
    }

    private void ToggleSelection(TKey id, object? checkedValue)
    {
        if (checkedValue is bool isChecked && isChecked)
            _selectedIds.Add(id);
        else
            _selectedIds.Remove(id);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            foreach (var item in _items)
            {
                _selectedIds.Add(IdSelector(item));
            }
        }
        else
        {
            var visibleIds = _items.Select(IdSelector).ToHashSet();
            _selectedIds.RemoveWhere(id => visibleIds.Contains(id));
        }
    }

    private void OpenAddModal()
    {
        if (IsReadOnly || DisableAdd || _isSaving || _isDeleting) return;
        _isEditMode = false;
        _currentItem = CreateNewItem != null ? CreateNewItem() : new TItem();
        _editContext = new EditContext(_currentItem);
        _isModalOpen = true;
    }

    private void OpenEditModal()
    {
        if (IsReadOnly || DisableEdit || _selectedIds.Count != 1 || _isSaving || _isDeleting) return;
        var selectedId = _selectedIds.First();
        var itemToEdit = _items.FirstOrDefault(i => EqualityComparer<TKey>.Default.Equals(IdSelector(i), selectedId));
        
        if (itemToEdit != null)
        {
            _isEditMode = true;
            _currentItem = CloneItemSafe(itemToEdit);
            _editContext = new EditContext(_currentItem);
            _isModalOpen = true;
        }
    }

    private TItem CloneItemSafe(TItem source)
    {
        if (CloneItem != null)
        {
            return CloneItem(source);
        }

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(source);
            return System.Text.Json.JsonSerializer.Deserialize<TItem>(json) ?? new TItem();
        }
        catch (Exception ex)
        {
            AppLog.Warn(ex, "Impossible de cloner l'élément de type {ItemType} via JSON, repli sur une nouvelle instance.", typeof(TItem).Name);
            return new TItem();
        }
    }

    private void CloseModal()
    {
        if (_isSaving) return;
        _isModalOpen = false;
    }

    private async Task SaveItemAsync()
    {
        if (_isSaving || IsReadOnly) return;
        if (_isEditMode && DisableEdit) return;
        if (!_isEditMode && DisableAdd) return;
        if (_editContext != null && !_editContext.Validate()) return;

        _isSaving = true;
        try
        {
            bool isSuccess;
            string? errorKey;

            if (_isEditMode)
            {
                var id = IdSelector(_currentItem);
                (isSuccess, errorKey) = await ApiClient.PutAsync($"{ApiEndpoint}/{id}", _currentItem);
            }
            else
            {
                (isSuccess, errorKey) = await ApiClient.PostAsync(ApiEndpoint, _currentItem);
            }

            if (isSuccess)
            {
                _isModalOpen = false;
                ToastService.ShowSuccess(Translation.GetString("app.success.saved"));
                await RefreshAsync();
            }
            else
            {
                var keyToTranslate = errorKey ?? "app.error.unknown";
                ToastService.ShowError(Translation.GetString(keyToTranslate));
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (_isDeleting || IsReadOnly || DisableDelete || _selectedIds.Count == 0) return;

        _isDeleting = true;
        try
        {
            bool isSuccess;
            string? errorKey;

            if (_selectedIds.Count == 1 && !UseBatchForSingleDelete)
            {
                (isSuccess, errorKey) = await ApiClient.DeleteAsync($"{ApiEndpoint}/{_selectedIds.First()}");
            }
            else
            {
                (isSuccess, errorKey) = await ApiClient.PostAsync($"{ApiEndpoint}/delete-batch", _selectedIds.ToList());
            }

            if (isSuccess)
            {
                _selectedIds.Clear();
                ToastService.ShowSuccess(Translation.GetString("app.success.deleted"));
                await RefreshAsync();
            }
            else
            {
                var keyToTranslate = errorKey ?? "app.error.unknown";
                ToastService.ShowError(Translation.GetString(keyToTranslate));
            }
        }
        finally
        {
            _isDeleting = false;
        }
    }

    public async Task ApplySortAsync(string columnName)
    {
        if (_table != null) await _table.ApplySortAsync(columnName);
    }

    public async Task ApplyFilterAsync(string columnName, string value)
    {
        if (_table != null) await _table.ApplyFilterAsync(columnName, value);
    }
}