@typeparam TItem where TItem : class, new()
@typeparam TKey where TKey : notnull
@inject TranslationService Translation
@inject ApiClient ApiClient
@inject ToastService ToastService
@inject ILogger<CrudTablePage<TItem, TKey>> Logger

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">@Title</h3>
        
        <div class="d-flex align-items-center gap-2">
            @if (CustomToolbarActions != null && _selectedIds.Count == 1)
            {
                var selectedItem = _items.FirstOrDefault(i => EqualityComparer<TKey>.Default.Equals(IdSelector(i), _selectedIds.First()));
                if (selectedItem != null)
                {
                    @CustomToolbarActions(selectedItem)
                }
            }

            @if (!IsReadOnly)
            {
                <div class="btn-group" role="group">
                    @if (!DisableAdd)
                    {
                        <button class="btn btn-primary" @onclick="OpenAddModal">
                            <i class="bi bi-plus-lg"></i> @Translation.GetString("common.add")
                        </button>
                    }
                    @if (!DisableEdit)
                    {
                        <button class="btn btn-outline-secondary" 
                                disabled="@(_selectedIds.Count != 1)" 
                                @onclick="OpenEditModal">
                            <i class="bi bi-pencil"></i> @Translation.GetString("common.edit")
                        </button>
                    }
                    @if (!DisableDelete)
                    {
                        <button class="btn btn-outline-danger" 
                                disabled="@(_selectedIds.Count == 0)" 
                                @onclick="DeleteSelectedAsync">
                            <i class="bi bi-trash"></i> @Translation.GetString("common.delete") (@_selectedIds.Count)
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Zone de filtres personnalisés injectée par la page parente -->
    @if (ToolbarFilters != null)
    {
        <div class="mb-3">
            @ToolbarFilters
        </div>
    }

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Translation.GetString("common.loading")</span>
            </div>
        </div>
    }
    else if (_items == null || !_items.Any())
    {
        @if (!string.IsNullOrEmpty(Description))
        {
            <p class="text-muted">@Description</p>
        }
        <div class="alert alert-secondary" role="alert">
            @EmptyMessage
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Description))
        {
            <p class="text-muted">@Description</p>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        @if (!IsReadOnly && (!DisableEdit || !DisableDelete))
                        {
                            <th style="width: 40px;">
                                <input type="checkbox" class="form-check-input" 
                                       checked="@IsAllSelected" 
                                       @onchange="ToggleSelectAll" />
                            </th>
                        }
                        @TableHeader
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        var id = IdSelector(item);
                        <tr class="@(_selectedIds.Contains(id) ? "table-active" : "")">
                            @if (!IsReadOnly && (!DisableEdit || !DisableDelete))
                            {
                                <td>
                                    <input type="checkbox" class="form-check-input" 
                                           checked="@_selectedIds.Contains(id)" 
                                           @onchange="(e) => ToggleSelection(id, e.Value)" />
                                </td>
                            }
                            @RowTemplate(item)
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Barre de pagination -->
        @if (_totalPages > 1)
        {
            <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Pagination">
                <span class="text-muted small">
                    @Translation.GetString("common.page") @_currentPage / @_totalPages
                </span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePageAsync(_currentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>
                    
                    @for (int i = 1; i <= _totalPages; i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(pageNumber == _currentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePageAsync(pageNumber)">@pageNumber</button>
                        </li>
                    }

                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePageAsync(_currentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@if (!IsReadOnly)
{
    <BaseModal IsOpen="@_isModalOpen" 
               Title="@(_isEditMode ? EditModalTitle : AddModalTitle)" 
               EditContext="@_editContext"
               OnSave="SaveItemAsync" 
               OnClose="CloseModal">
        @if (_editContext != null && FormFields != null)
        {
            <EditForm EditContext="@_editContext">
                <DataAnnotationsValidator />
                @FormFields(_currentItem)
            </EditForm>
        }
    </BaseModal>
}

@code {
    [Parameter, EditorRequired] public string ApiEndpoint { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Func<TItem, TKey> IdSelector { get; set; } = default!;
    [Parameter] public Func<TItem>? CreateNewItem { get; set; }
    [Parameter] public Func<TItem, TItem>? CloneItem { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = string.Empty;
    [Parameter] public string AddModalTitle { get; set; } = string.Empty;
    [Parameter] public string EditModalTitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment TableHeader { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    [Parameter] public RenderFragment<TItem>? FormFields { get; set; }
    [Parameter] public RenderFragment<TItem>? CustomToolbarActions { get; set; }
    [Parameter] public RenderFragment? ToolbarFilters { get; set; }

    // Nouveaux paramètres optionnels pour les filtres et le tri
    [Parameter] public Dictionary<string, string>? AdditionalQueryParameters { get; set; }
    [Parameter] public string? SortBy { get; set; }
    [Parameter] public bool SortAscending { get; set; } = true;

    [Parameter] public bool IsReadOnly { get; set; } = false;
    [Parameter] public bool DisableAdd { get; set; } = false;
    [Parameter] public bool DisableEdit { get; set; } = false;
    [Parameter] public bool DisableDelete { get; set; } = false;

    [Parameter] public int PageSize { get; set; } = 10;
    
    private List<TItem> _items = new();
    private HashSet<TKey> _selectedIds = new();
    private bool _isLoading = true;
    private bool _isModalOpen = false;
    private bool _isEditMode = false;
    private TItem _currentItem = new();
    private EditContext? _editContext;

    private int _currentPage = 1;
    private int _totalPages = 1;

    private bool IsAllSelected => _items.Any() && _selectedIds.Count == _items.Count;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    /// <summary>
    /// Permet de recharger les données en changeant de page ou en appliquant des filtres depuis l'extérieur
    /// </summary>
    public async Task LoadDataAsync()
    {
        _isLoading = true;
        _selectedIds.Clear();
        try
        {
            // Construction dynamique de l'URL avec pagination, tri et filtres additionnels
            var queryParams = new List<string>
            {
                $"page={_currentPage}",
                $"pageSize={PageSize}"
            };

            if (!string.IsNullOrEmpty(SortBy))
            {
                queryParams.Add($"sortBy={Uri.EscapeDataString(SortBy)}");
                queryParams.Add($"ascending={SortAscending.ToString().ToLower()}");
            }

            if (AdditionalQueryParameters != null)
            {
                foreach (var param in AdditionalQueryParameters)
                {
                    if (!string.IsNullOrEmpty(param.Value))
                    {
                        queryParams.Add($"{Uri.EscapeDataString(param.Key)}={Uri.EscapeDataString(param.Value)}");
                    }
                }
            }

            string separator = ApiEndpoint.Contains("?") ? "&" : "?";
            var url = $"{ApiEndpoint}{separator}{string.Join("&", queryParams)}";

            var pagedResult = await ApiClient.GetFromJsonAsync<PagedResultDto<TItem>>(url);
            
            if (pagedResult != null)
            {
                _items = pagedResult.Items ?? new();
                _totalPages = pagedResult.TotalPages > 0 ? pagedResult.TotalPages : 1;
            }
            else
            {
                _items = new();
                _totalPages = 1;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors du chargement des données pour l'endpoint {Endpoint}", ApiEndpoint);
            _items = new();
            ToastService.ShowError(Translation.GetString("app.error.unknown"));
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Méthode publique à appeler depuis la page parente lorsque l'utilisateur modifie un filtre de recherche
    /// </summary>
    public async Task ApplyFiltersAsync(Dictionary<string, string> filters, string? newSortBy = null, bool? sortAscending = null)
    {
        AdditionalQueryParameters = filters;
        if (newSortBy != null) SortBy = newSortBy;
        if (sortAscending.HasValue) SortAscending = sortAscending.Value;
        
        _currentPage = 1; // On revient à la première page lors d'un filtre
        await LoadDataAsync();
    }

    private async Task ChangePageAsync(int newPage)
    {
        if (newPage < 1 || newPage > _totalPages || newPage == _currentPage) return;
        _currentPage = newPage;
        await LoadDataAsync();
    }

    private void ToggleSelection(TKey id, object? checkedValue)
    {
        if (checkedValue is bool isChecked && isChecked) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
            _selectedIds = _items.Select(IdSelector).ToHashSet();
        else
            _selectedIds.Clear();
    }

    private void OpenAddModal()
    {
        if (IsReadOnly || DisableAdd) return;
        _isEditMode = false;
        _currentItem = CreateNewItem != null ? CreateNewItem() : new TItem();
        _editContext = new EditContext(_currentItem);
        _isModalOpen = true;
        StateHasChanged(); 
    }

    private void OpenEditModal()
    {
        if (IsReadOnly || DisableEdit || _selectedIds.Count != 1) return;
        var selectedId = _selectedIds.First();
        var itemToEdit = _items.FirstOrDefault(i => EqualityComparer<TKey>.Default.Equals(IdSelector(i), selectedId));
        
        if (itemToEdit != null)
        {
            _isEditMode = true;
            _currentItem = CloneItem != null 
                ? CloneItem(itemToEdit) 
                : System.Text.Json.JsonSerializer.Deserialize<TItem>(System.Text.Json.JsonSerializer.Serialize(itemToEdit))!;
            
            _editContext = new EditContext(_currentItem);
            _isModalOpen = true;
        }
    }

    private void CloseModal() => _isModalOpen = false;

    private async Task SaveItemAsync()
    {
        if (IsReadOnly) return;
        if (_editContext != null && !_editContext.Validate()) return;

        bool isSuccess;
        string? errorKey;

        if (_isEditMode)
        {
            var id = IdSelector(_currentItem);
            (isSuccess, errorKey) = await ApiClient.PutAsync($"{ApiEndpoint}/{id}", _currentItem);
        }
        else
        {
            (isSuccess, errorKey) = await ApiClient.PostAsync(ApiEndpoint, _currentItem);
        }

        if (isSuccess)
        {
            _isModalOpen = false; // Corrigé ici (suppression du / ou du = en trop)
            ToastService.ShowSuccess(Translation.GetString("app.success.saved"));
            await LoadDataAsync();
        }
        else
        {
            var keyToTranslate = errorKey ?? "app.error.unknown";
            ToastService.ShowError(Translation.GetString(keyToTranslate));
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (IsReadOnly || DisableDelete || !_selectedIds.Any()) return;

        bool isSuccess;
        string? errorKey;

        if (_selectedIds.Count == 1)
        {
            (isSuccess, errorKey) = await ApiClient.DeleteAsync($"{ApiEndpoint}/{_selectedIds.First()}");
        }
        else
        {
            (isSuccess, errorKey) = await ApiClient.PostAsync($"{ApiEndpoint}/delete-batch", _selectedIds.ToList());
        }

        if (isSuccess)
        {
            ToastService.ShowSuccess(Translation.GetString("app.success.deleted"));
            if (_items.Count == _selectedIds.Count && _currentPage > 1)
            {
                _currentPage--;
            }
            await LoadDataAsync();
        }
        else
        {
            var keyToTranslate = errorKey ?? "app.error.unknown";
            ToastService.ShowError(Translation.GetString(keyToTranslate));
        }
    }
}