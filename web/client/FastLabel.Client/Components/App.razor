@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="@GetLanguage()">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <HeadOutlet @rendermode="InteractiveServer" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FastLabel.Client.styles.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/appInterop.js"></script>
</body>

</html>

@code {
    private string GetLanguage()
    {
        try
        {
            var cookieValue = HttpContextAccessor.HttpContext?.Request.Cookies["language"];
            if (!string.IsNullOrEmpty(cookieValue))
            {
                return cookieValue.StartsWith("fr", StringComparison.OrdinalIgnoreCase) ? "fr" : "en";
            }
        }
        catch
        {
        }
        return "fr";
    }
}