@inherits TranslatableComponent
@inject NavigationManager Navigation
@inject CookieService CookieService
@implements IDisposable

<PageTitle>FastLabel - @GetSafePageTitle()</PageTitle>

@if (!_isLoaded)
{
    <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="d-flex flex-column min-vh-100 bg-light">
        <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" href="/">FastLabel</a>

                <div class="d-flex align-items-center">
                    <div class="dropdown @(_isDropdownOpen ? "show" : "")">
                        <button class="btn btn-outline-secondary dropdown-toggle btn-sm d-flex align-items-center"
                                type="button" @onclick="ToggleDropdown">
                            <i class="bi bi-globe me-1"></i>
                            <span>@(Translation.CurrentLanguage.StartsWith("fr", StringComparison.OrdinalIgnoreCase) ? "Français" : "English")</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow-sm @(_isDropdownOpen ? "show" : "")"
                            style="position: absolute; right: 0; left: auto;">
                            <li>
                                <button class="dropdown-item @(Translation.CurrentLanguage.Equals("fr", StringComparison.OrdinalIgnoreCase) ? "active" : "")" type="button"
                                        @onclick='() => ChangeLanguage("fr")'>
                                    🇫🇷 Français (FR)
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item @(Translation.CurrentLanguage.Equals("en", StringComparison.OrdinalIgnoreCase) ? "active" : "")" type="button"
                                        @onclick='() => ChangeLanguage("en")'>
                                    🇬🇧 English (EN)
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <div class="container d-flex justify-content-center align-items-center flex-grow-1 py-4">
            <div class="w-100" style="max-width: 450px;">
                @Body
            </div>
        </div>
    </div>
}

@code {
    private bool _isDropdownOpen = false;
    private bool _isLoaded = false;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        var cookieLang = await CookieService.GetCookieAsync("language");
            
        if (!string.IsNullOrEmpty(cookieLang))
        {
            await Translation.InitializeAsync(cookieLang);
        }
        else
        {
            await Translation.InitializeAsync();
        }
        
        _isLoaded = true;
        StateHasChanged();
    }

    private string GetSafePageTitle()
    {
        var uri = Navigation.Uri.ToLower();

        if (uri.Contains("/"))
        {
            var title = Translation.GetString("auth.login_title");
            return title == "auth.login_title" ? (Translation.CurrentLanguage.StartsWith("fr") ? "Connexion" : "Sign In") : title;
        }
        if (uri.Contains("/register"))
        {
            var title = Translation.GetString("auth.register_title");
            return title == "auth.register_title" ? (Translation.CurrentLanguage.StartsWith("fr") ? "Inscription" : "Register") : title;
        }
        if (uri.Contains("/forgot-password"))
        {
            var title = Translation.GetString("auth.forgot_heading");
            return title == "auth.forgot_heading" ? (Translation.CurrentLanguage.StartsWith("fr") ? "Mot de passe oublié" : "Forgot Password") : title;
        }

        var defaultTitle = Translation.GetString("nav.home");
        return defaultTitle == "nav.home" ? (Translation.CurrentLanguage.StartsWith("fr") ? "Accueil" : "Home") : defaultTitle;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Navigation.LocationChanged -= OnLocationChanged;
        }

        base.Dispose(disposing);
    }

    private void ToggleDropdown()
    {
        _isDropdownOpen = !_isDropdownOpen;
    }

    private async Task ChangeLanguage(string languageCode)
    {
        _isDropdownOpen = false;

        await CookieService.SetCookieAsync("language", languageCode, days: 365);
        await Translation.InitializeAsync(languageCode);
    }
}