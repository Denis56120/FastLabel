@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TranslationService Translation
@implements IDisposable

<PageTitle>FastLabel - @GetCurrentPageTitle()</PageTitle>

@if (!_isLoaded)
{
    <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="app-container d-flex flex-column vh-100">
        <!-- Bandeau supérieur -->
        <header class="navbar navbar-dark bg-dark px-3 shadow-sm d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <NavLink class="navbar-brand fw-bold text-white text-decoration-none" href="/">
                    FastLabel
                </NavLink>

                <!-- Bouton Accueil dynamique -->
                <NavLink class="btn btn-outline-secondary btn-sm text-white border-secondary d-flex align-items-center gap-1" href="/">
                    <i class="bi bi-house-door"></i>
                    <span>@Translation.GetString("nav.home")</span>
                </NavLink>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <!-- Sélecteur de langue 100% Blazor -->
                <div class="d-flex align-items-center">
                    <div class="dropdown @(_isDropdownOpen ? "show" : "")">
                        <!-- Bouton principal -->
                        <button class="btn btn-outline-secondary dropdown-toggle btn-sm d-flex align-items-center text-white border-secondary"
                                type="button" @onclick="ToggleDropdown">
                            <i class="bi bi-globe me-1"></i>
                            <span>@(_currentCulture.StartsWith("fr", StringComparison.OrdinalIgnoreCase) ? "Français" : "English")</span>
                        </button>

                        <!-- La liste déroulante -->
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm @(_isDropdownOpen ? "show" : "")"
                            style="position: absolute; right: 0; left: auto;">
                            <li>
                                <button class="dropdown-item @(_currentCulture.Equals("fr_FR", StringComparison.OrdinalIgnoreCase) ? "active" : "")" type="button"
                                        @onclick='() => ChangeLanguage("fr_FR")'>
                                    🇫🇷 Français (FR)
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item @(_currentCulture.Equals("en_GB", StringComparison.OrdinalIgnoreCase) ? "active" : "")" type="button"
                                        @onclick='() => ChangeLanguage("en_GB")'>
                                    🇬🇧 English (EN)
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Accès Account -->
                <NavLink class="btn btn-outline-light btn-sm" href="/account">
                    <i class="bi bi-person-circle"></i> @Translation.GetString("nav.my_account")
                </NavLink>

                <!-- Bouton Déconnexion -->
                <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right"></i> @Translation.GetString("nav.logout")
                </button>
            </div>
        </header>

        <div class="d-flex flex-grow-1 overflow-hidden">
            <!-- Bandeau latéral gauche -->
            <nav class="bg-light border-end p-3 d-flex flex-column" style="width: 260px;">
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item">
                        <NavLink class="nav-link text-dark" href="/templates" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-file-earmark-text me-2"></i> @Translation.GetString("nav.templates")
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-dark" href="/printers" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-printer me-2"></i> @Translation.GetString("nav.printers")
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-dark" href="/agents" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-pc-display me-2"></i> @Translation.GetString("nav.agents")
                        </NavLink>
                    </li>
                    <AuthorizeView Roles="Admin">
                        <li class="nav-item">
                            <NavLink class="nav-link text-dark" href="/users" Match="NavLinkMatch.Prefix">
                                <i class="bi bi-people me-2"></i> @Translation.GetString("nav.users")
                            </NavLink>
                        </li>
                    </AuthorizeView>
                    <li class="nav-item">
                        <NavLink class="nav-link text-dark" href="/history" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-clock-history me-2"></i> @Translation.GetString("nav.history")
                        </NavLink>
                    </li>
                </ul>
            </nav>

            <!-- Zone de contenu dynamique (Dashboard) -->
            <main class="flex-grow-1 p-4 overflow-y-auto bg-white">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private string _currentCulture = "fr_FR";
    private bool _isLoaded = false;
    private bool _isDropdownOpen = false;

    protected override async Task OnInitializedAsync()
    {
        Translation.OnChange += OnTranslationChanged;

        // Si le service connaît déjà une culture (ex: en venant du PublicLayout), on l'adopte instantanément
        if (!string.IsNullOrEmpty(Translation.CurrentCulture))
        {
            _currentCulture = Translation.CurrentCulture;
        }
        else
        {
            try
            {
                var savedCulture = await JS.InvokeAsync<string>("localStorage.getItem", "preferred_language");
                if (!string.IsNullOrEmpty(savedCulture))
                {
                    _currentCulture = savedCulture;
                }
            }
            catch
            {
                // Ignore
            }
        }

        await Translation.InitializeAsync(_currentCulture);
        _isLoaded = true;
    }

    private string GetCurrentPageTitle()
    {
        var uri = Navigation.Uri.ToLower();

        if (uri.Contains("/account"))
            return Translation.GetString("nav.my_account");
        if (uri.Contains("/templates"))
            return Translation.GetString("nav.templates");
        if (uri.Contains("/printers"))
            return Translation.GetString("nav.printers");
        if (uri.Contains("/agents"))
            return Translation.GetString("nav.agents");
        if (uri.Contains("/users"))
            return Translation.GetString("nav.users");
        if (uri.Contains("/history"))
            return Translation.GetString("nav.history");

        return Translation.GetString("nav.home");
    }

    private void ToggleDropdown()
    {
        _isDropdownOpen = !_isDropdownOpen;
    }

    private void OnTranslationChanged()
    {
        if (_isLoaded)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Translation.OnChange -= OnTranslationChanged;
    }

    private async Task ChangeLanguage(string cultureCode)
    {
        _currentCulture = cultureCode;
        _isDropdownOpen = false;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "preferred_language", _currentCulture);
        }
        catch
        {
            // Ignore
        }

        await Translation.InitializeAsync(_currentCulture);
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}